// Workshop UI - Crafting blueprint selection and resource management
// Blueprint grid: 3 columns × 8 rows evenly spaced
// Materials: 4 slots shown bottom-up as needed
$C = "../Common.ui";

// Sizing vars
@RootWidth = 1700;
@RootHeight = 880;

@Pad = 50;
@LeftWidth = 460;
@RightWidth = 430;
@PreviewSize = 220;
@WeaponSlotWidth = 208;
@WeaponSlotHeight = 130;

@CardPad = 36;
@TagPadX = 16;
@TagPadY = 5;

@QtyBtnWidth = 60;
@QtyBtnHeight = 52;
@QtyValWidth = 110;

@MainBtnHeight = 60;

// Material slot sizing
@MatSlotHeight = 70;
@MatIconSize = 46;
@MatGap = 8;

// Colors - darker overlay background
@OverlayBg = #000000(0.0);

@BpBtnBg = #141e28(0.95);
@BpBtnBorderColor = #64788c(0.6);

@CardBg = #f5f0e8;
@ReqIconBoxBg = #1a2332;

@QtyBtnBg = #4a76a8;
@QtyValBg = #ffffff;
@QtyValBorderColor = #d0d0d0;

@CraftBg = #fbbf24;
@TagBg = #4ade80;

@HitBg = #ffffff(0.01); // tiny alpha so it receives input

// Text colors
@White = #ffffff;
@Black = #1a1a1a;
@GrayA = #aaaaaa;
@Gray6 = #666666;
@Gray3 = #333333;
@TagText = #064e3b;
@DividerColor = #d0d0d0;

// Workbench nav sizing
@WbNavHeight = 120;
@WbBtnSize = 90;
@WbBtnGap = 20;
@WbBtnBg = #2a3a4a;
@WbBtnSelectedBg = #5a8fc8;
@BpSlotSize = 110;
@BpIconSize = 96;
@BpGap = 10;

// Root overlay
Group #PageOverlay {
  FlexWeight: 1;
  LayoutMode: Middle;
  Background: @OverlayBg;

  // Main container centered
  Group #WorkshopRoot {
    Anchor: (Width: @RootWidth, Height: @RootHeight);
    LayoutMode: Top;
    Padding: (Left: @Pad, Right: @Pad, Bottom: @Pad);

    Group #TopControls {
      Anchor: (Height: 48);
      LayoutMode: Right;

      Button #BackBtn {
        Anchor: (Width: 140, Height: 44);
        Style: (
          Default: (Background: #1e2d3f(0.95)),
          Hovered: (Background: #2a3d54(0.95)),
          Pressed: (Background: #172434(0.95))
        );
        Label {
          Text: "BACK";
          Style: (FontSize: 16, TextColor: @White, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }

    Group { Anchor: (Height: 10); }

    // Main content area - three panels side by side
    Group #WorkshopContent {
      FlexWeight: 1;
      LayoutMode: Left;

      // LEFT PANEL - Blueprints (3 columns × 8 rows evenly spaced)
      Group #LeftPanel {
      Anchor: (Width: @LeftWidth);
      LayoutMode: Top;
      Padding: (Right: 0);

      Label #BpTitle {
        Text: "TRADES";
        Style: (
          FontSize: 24,
          TextColor: @White,
          RenderBold: true
        );
        Anchor: (Height: 30);
      }

      Group { Anchor: (Height: 8); }

      // Category tabs
      Group #TabsRow {
        LayoutMode: Left;
        Anchor: (Height: 36);
        Button #TabAll { Anchor: (Width: 60, Height: 32); Style: (Default: (Background: (Color: #4a6a8a)), Hovered: (Background: (Color: #5a7a9a)), Pressed: (Background: (Color: #3a5a7a))); Label { Text: "All"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); } }
        Group { Anchor: (Width: 6); }
        Button #TabWeapons { Anchor: (Width: 80, Height: 32); Style: (Default: (Background: (Color: #4a6a8a)), Hovered: (Background: (Color: #5a7a9a)), Pressed: (Background: (Color: #3a5a7a))); Label { Text: "Weapons"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); } }
        Group { Anchor: (Width: 6); }
        Button #TabArmor { Anchor: (Width: 70, Height: 32); Style: (Default: (Background: (Color: #4a6a8a)), Hovered: (Background: (Color: #5a7a9a)), Pressed: (Background: (Color: #3a5a7a))); Label { Text: "Armor"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); } }
        Group { Anchor: (Width: 6); }
        Button #TabShields { Anchor: (Width: 70, Height: 32); Style: (Default: (Background: (Color: #4a6a8a)), Hovered: (Background: (Color: #5a7a9a)), Pressed: (Background: (Color: #3a5a7a))); Label { Text: "Shields"; Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); } }
        Group { FlexWeight: 1; }
      }

      Group { Anchor: (Height: 8); }

      Group #BpScrollerWrapper {
        FlexWeight: 1;

        Group #BpScroller {
          Anchor: (Width: @LeftWidth, Top: 0, Bottom: 0);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Group #BpGrid {
            Anchor: (Left: 0, Right: 0);
            LayoutMode: Top;

          // Blueprint slot template - each cell contains 6 possible states (3 rarities × 2 lock states)
          // Usage: BpXCommonUnlocked, BpXUncommonUnlocked, BpXRareUnlocked, BpXCommonLocked, etc.

        // Row 0
        Group { LayoutMode: Left;
          Group #Bp0Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp0CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp0CommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp0UncommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp0UncommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp0RareUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp0RareUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp0CommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Common Item Locked.png");
              ItemIcon #Bp0CommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp0UncommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Uncommon Item Locked.png");
              ItemIcon #Bp0UncommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp0RareLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Rare Item Locked.png");
              ItemIcon #Bp0RareLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
          }
          Group { Anchor: (Width: 20); }
          Group #Bp1Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp1CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp1CommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp1UncommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp1UncommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp1RareUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp1RareUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp1CommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Common Item Locked.png");
              ItemIcon #Bp1CommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp1UncommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Uncommon Item Locked.png");
              ItemIcon #Bp1UncommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp1RareLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Rare Item Locked.png");
              ItemIcon #Bp1RareLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
          }
        }
        Group { Anchor: (Height: 20); }

        // Row 1
        Group { LayoutMode: Left;
          Group #Bp2Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp2CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp2CommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp2UncommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp2UncommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp2RareUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp2RareUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp2CommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Common Item Locked.png");
              ItemIcon #Bp2CommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp2UncommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Uncommon Item Locked.png");
              ItemIcon #Bp2UncommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp2RareLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Rare Item Locked.png");
              ItemIcon #Bp2RareLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
          }
          Group { Anchor: (Width: 20); }
          Group #Bp3Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp3CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp3CommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp3UncommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp3UncommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp3RareUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp3RareUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp3CommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Common Item Locked.png");
              ItemIcon #Bp3CommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp3UncommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Uncommon Item Locked.png");
              ItemIcon #Bp3UncommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp3RareLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Rare Item Locked.png");
              ItemIcon #Bp3RareLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
          }
        }
        Group { Anchor: (Height: 20); }

        // Row 2
        Group { LayoutMode: Left;
          Group #Bp4Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp4CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp4CommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp4UncommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp4UncommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp4RareUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp4RareUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp4CommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Common Item Locked.png");
              ItemIcon #Bp4CommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp4UncommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Uncommon Item Locked.png");
              ItemIcon #Bp4UncommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp4RareLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Rare Item Locked.png");
              ItemIcon #Bp4RareLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
          }
          Group { Anchor: (Width: 20); }
          Group #Bp5Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp5CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp5CommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp5UncommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp5UncommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp5RareUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp5RareUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp5CommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Common Item Locked.png");
              ItemIcon #Bp5CommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp5UncommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Uncommon Item Locked.png");
              ItemIcon #Bp5UncommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp5RareLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Rare Item Locked.png");
              ItemIcon #Bp5RareLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
          }
        }
        Group { Anchor: (Height: 20); }

        // Row 3
        Group { LayoutMode: Left;
          Group #Bp6Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp6CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp6CommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp6UncommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp6UncommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp6RareUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp6RareUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp6CommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Common Item Locked.png");
              ItemIcon #Bp6CommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp6UncommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Uncommon Item Locked.png");
              ItemIcon #Bp6UncommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp6RareLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Rare Item Locked.png");
              ItemIcon #Bp6RareLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
          }
          Group { Anchor: (Width: 20); }
          Group #Bp7Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp7CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp7CommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp7UncommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp7UncommonUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Button #Bp7RareUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
              Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
              ItemIcon #Bp7RareUnlockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp7CommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Common Item Locked.png");
              ItemIcon #Bp7CommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp7UncommonLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Uncommon Item Locked.png");
              ItemIcon #Bp7UncommonLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
            Group #Bp7RareLocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Background: (TexturePath: "Workshop/Rare Item Locked.png");
              ItemIcon #Bp7RareLockedIcon { Anchor: (Width: 80, Height: 80); }
            }
          }
        }
        Group { Anchor: (Height: 20); }


        // Row 4
        Group { LayoutMode: Left;
          Group #Bp8Cell { Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);
            Button #Bp8CommonUnlocked { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); LayoutMode: Middle; Style: (Default: (Background: (TexturePath: "Workshop/ItemSlotUnselected.png")));
                          Group #Selected { Visible: false; Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0); Background: (TexturePath: "Workshop/ItemSlotSelected.png"); }
