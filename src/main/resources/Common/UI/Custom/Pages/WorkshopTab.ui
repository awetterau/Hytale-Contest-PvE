// Workshop UI - Crafting blueprint selection and resource management
// Blueprint grid: 3 columns × 8 rows evenly spaced
// Materials: 4 slots shown bottom-up as needed
$C = "../Common.ui";

// Sizing vars
@RootWidth = 1700;
@RootHeight = 880;

@Pad = 50;
@LeftWidth = 460;
@RightWidth = 430;
@PreviewSize = 220;
@WeaponSlotWidth = 208;
@WeaponSlotHeight = 130;

@CardPad = 36;
@TagPadX = 16;
@TagPadY = 5;

@QtyBtnWidth = 60;
@QtyBtnHeight = 52;
@QtyValWidth = 110;

@MainBtnHeight = 60;

// Material slot sizing
@MatSlotHeight = 70;
@MatIconSize = 46;
@MatGap = 8;

// Colors - darker overlay background
@OverlayBg = #000000(0.0);

@BpBtnBg = #141e28(0.95);
@BpBtnBorderColor = #64788c(0.6);

@CardBg = #f5f0e8;
@ReqIconBoxBg = #1a2332;

@QtyBtnBg = #4a76a8;
@QtyValBg = #ffffff;
@QtyValBorderColor = #d0d0d0;

@CraftBg = #fbbf24;
@TagBg = #4ade80;

@HitBg = #ffffff(0.01); // tiny alpha so it receives input

// Text colors
@White = #ffffff;
@Black = #1a1a1a;
@GrayA = #aaaaaa;
@Gray6 = #666666;
@Gray3 = #333333;
@TagText = #064e3b;
@DividerColor = #d0d0d0;

// Workbench nav sizing
@WbNavHeight = 120;
@WbBtnSize = 90;
@WbBtnGap = 20;
@WbBtnBg = #2a3a4a;
@WbBtnSelectedBg = #5a8fc8;
@BpSlotSize = 110;
@BpIconSize = 96;
@BpGap = 10;

// Root overlay
Group #PageOverlay {
  FlexWeight: 1;
  LayoutMode: Middle;
  Background: @OverlayBg;

  // Main container centered
  Group #WorkshopRoot {
    Anchor: (Width: @RootWidth, Height: @RootHeight);
    LayoutMode: Top;
    Padding: (Left: @Pad, Right: @Pad, Bottom: @Pad);

    Group #TopControls {
      Anchor: (Height: 48);
      LayoutMode: Right;

      Button #BackBtn {
        Anchor: (Width: 140, Height: 44);
        Style: (
          Default: (Background: #1e2d3f(0.95)),
          Hovered: (Background: #2a3d54(0.95)),
          Pressed: (Background: #172434(0.95))
        );
        Label {
          Text: "BACK";
          Style: (FontSize: 16, TextColor: @White, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }

    Group { Anchor: (Height: 10); }

    // Main content area - three panels side by side (fixed height to prevent resizing)
    Group #WorkshopContent {
      Anchor: (Height: 670);
      LayoutMode: Left;

      // LEFT PANEL - Blueprints (3 columns × 8 rows evenly spaced)
      Group #LeftPanel {
      Anchor: (Width: @LeftWidth);
      LayoutMode: Top;
      Padding: (Right: 0);

      Label #BpTitle {
        Text: "TRADES";
        Style: (
          FontSize: 24,
          TextColor: @White,
          RenderBold: true
        );
        Anchor: (Height: 30);
      }

      Group { Anchor: (Height: 14); }

      Group #BpGrid {
        FlexWeight: 1;
        LayoutMode: Top;

        Group { LayoutMode: Left;
          Group #Bp0Cell {
            Anchor: (Width: @WeaponSlotWidth, Height: @WeaponSlotHeight);

            Button #Bp0CommonUnlocked {
              Anchor: (Full: 0);
              Style: (
                Default: (Background: "Stash/CommonItem/Weapon/Common Item.png"),
                Hovered: (Background: "Stash/CommonItem/Weapon/CommonHover.png"),
                Pressed: (Background: "Stash/CommonItem/Weapon/CommonSelected.png")
              );
              Group #Selected { Visible: false; Anchor: (Full: 0); Background: (TexturePath: "Stash/CommonItem/Weapon/CommonSelected.png"); }
              ItemIcon #Bp0CommonUnlockedIcon { Anchor: (Left: 58, Right: 58, Top: 19, Bottom: 19); }
            }

            Button #Bp0CommonLocked {
              Visible: false;
              Anchor: (Full: 0);
              Style: (
                Default: (Background: "Workshop/Common Item Locked.png")
              );
              ItemIcon #Bp0CommonLockedIcon { Anchor: (Left: 58, Right: 58, Top: 19, Bottom: 19); }
              Group #Shade { Anchor: (Full: 0); Background: #000000(0.5); }
            }

            Button #Bp0UncommonUnlocked {
              Visible: false;
              Anchor: (Full: 0);
              Style: (
                Default: (Background: "Stash/UncommonItem/Weapon/Uncommon Item.png"),
                Hovered: (Background: "Stash/UncommonItem/Weapon/UncommonHover.png"),
                Pressed: (Background: "Stash/UncommonItem/Weapon/UncommonSelected.png")
              );
              Group #Selected { Visible: false; Anchor: (Full: 0); Background: (TexturePath: "Stash/UncommonItem/Weapon/UncommonSelected.png"); }
              ItemIcon #Bp0UncommonUnlockedIcon { Anchor: (Left: 58, Right: 58, Top: 19, Bottom: 19); }
            }

            Button #Bp0UncommonLocked {
              Visible: false;
              Anchor: (Full: 0);
              Style: (
                Default: (Background: "Workshop/Uncommon Item Locked.png")
              );
              ItemIcon #Bp0UncommonLockedIcon { Anchor: (Left: 58, Right: 58, Top: 19, Bottom: 19); }
              Group #Shade { Anchor: (Full: 0); Background: #000000(0.5); }
            }

            Button #Bp0RareUnlocked {
              Visible: false;
              Anchor: (Full: 0);
              Style: (
                Default: (Background: "Stash/RareItem/Weapon/Rare Item.png"),
                Hovered: (Background: "Stash/RareItem/Weapon/Rare Hover.png"),
                Pressed: (Background: "Stash/RareItem/Weapon/Rare Selected.png")
