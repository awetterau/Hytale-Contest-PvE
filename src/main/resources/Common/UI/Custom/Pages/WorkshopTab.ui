              );
              ItemIcon #Bp6RareLockedIcon { Anchor: (Left: 58, Right: 58, Top: 19, Bottom: 19); }
              Group #Shade { Anchor: (Full: 0); Background: #000000(0.5); }
            }
          }
        }

        Group { FlexWeight: 1; }
      }
    }

    // MIDDLE PANEL - intentionally empty (reserved spacing for layout balance)
    Group #MiddlePanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Left: (@Pad + 200), Right: (@Pad + 200));
      Group { FlexWeight: 1; }
    }

    // RIGHT PANEL - Info Card with MaterialsBackground
    Group #RightPanel {
      Anchor: (Width: @RightWidth);
      LayoutMode: Middle;

      Group #Card {
        Anchor: (Width: @RightWidth);
        LayoutMode: Top;
        Padding: (Left: @CardPad, Right: @CardPad, Top: @CardPad, Bottom: @CardPad);
        Background: (TexturePath: "Workshop/MaterialsBackground.png");

        // Tag row - just rarity
        Group #TagRow {
          LayoutMode: Left;

          Group #TagRarity {
            LayoutMode: Middle;
            Background: (Color: @TagBg);
            Padding: (Left: @TagPadX, Right: @TagPadX, Top: @TagPadY, Bottom: @TagPadY);

            Label #RarityLabel {
              Text: "UNCOMMON";
              Style: (FontSize: 12, TextColor: @TagText, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Center);
              Anchor: (Height: 16);
            }
          }
        }

        Group { Anchor: (Height: 10); }

        Label #ItemName {
          Text: "MYSTIC BINDING CLOTH";
          Style: (FontSize: 26, TextColor: @Black, RenderBold: true);
          Anchor: (Height: 20);
        }

        Group { Anchor: (Height: 16); }

        Label #ItemDesc {
          Text: "Used to craft a wide-range of items. Can be recycled into crafting materials.";
          Style: (FontSize: 15, TextColor: @Gray6);
        }

        Group { Anchor: (Height: 32); }

        Label #ReqTitle {
          Text: "REQUIRED RESOURCES";
          Style: (FontSize: 14, TextColor: @Gray3, RenderBold: true);
          Anchor: (Height: 18);
        }

        Group { Anchor: (Height: 20); }

        // 4 Material slots (shown bottom-up, hidden when not needed)
        // Slot 0 (top)
        Group #ReqRow0 {
          LayoutMode: Left;
          Padding: (Top: 12, Bottom: 12);

          Group #ReqIconBox0 {
            Anchor: (Width: @MatSlotHeight, Height: @MatSlotHeight);
            LayoutMode: Middle;
            Background: (TexturePath: "Stash/Item/Weapon/Item.png");

            ItemIcon #ReqIcon0 {
              Anchor: (Width: @MatIconSize, Height: @MatIconSize);
            }
          }

          Group { Anchor: (Width: 18); }

          Group #ReqText0 {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #ReqName0 {
              Text: "Material Name";
              Style: (FontSize: 16, TextColor: @Black, RenderBold: true);
              Anchor: (Height: 20);
            }

            Group { Anchor: (Height: 6); }

            Label #ReqCount0 {
              Text: "0/1";
              Style: (FontSize: 15, TextColor: @Gray6);
              Anchor: (Height: 18);
            }
          }
        }

        // Divider 0-1
        Group #Divider0 {
          Anchor: (Height: 1);
          Background: (Color: @DividerColor);
        }

        // Slot 1
        Group #ReqRow1 {
          LayoutMode: Left;
          Padding: (Top: 12, Bottom: 12);

          Group #ReqIconBox1 {
            Anchor: (Width: @MatSlotHeight, Height: @MatSlotHeight);
            LayoutMode: Middle;
            Background: (TexturePath: "Stash/Item/Weapon/Item.png");

            ItemIcon #ReqIcon1 {
              Anchor: (Width: @MatIconSize, Height: @MatIconSize);
            }
          }

          Group { Anchor: (Width: 18); }

          Group #ReqText1 {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #ReqName1 {
              Text: "Material Name";
              Style: (FontSize: 16, TextColor: @Black, RenderBold: true);
              Anchor: (Height: 20);
            }

            Group { Anchor: (Height: 6); }

            Label #ReqCount1 {
              Text: "0/1";
              Style: (FontSize: 15, TextColor: @Gray6);
              Anchor: (Height: 18);
            }
          }
        }

        // Divider 1-2
        Group #Divider1 {
          Anchor: (Height: 1);
          Background: (Color: @DividerColor);
        }

        // Slot 2
        Group #ReqRow2 {
          LayoutMode: Left;
          Padding: (Top: 12, Bottom: 12);

          Group #ReqIconBox2 {
            Anchor: (Width: @MatSlotHeight, Height: @MatSlotHeight);
            LayoutMode: Middle;
            Background: (TexturePath: "Stash/Item/Weapon/Item.png");

            ItemIcon #ReqIcon2 {
              Anchor: (Width: @MatIconSize, Height: @MatIconSize);
            }
          }

          Group { Anchor: (Width: 18); }

          Group #ReqText2 {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #ReqName2 {
              Text: "Material Name";
              Style: (FontSize: 16, TextColor: @Black, RenderBold: true);
              Anchor: (Height: 20);
            }

            Group { Anchor: (Height: 6); }

            Label #ReqCount2 {
              Text: "0/1";
              Style: (FontSize: 15, TextColor: @Gray6);
              Anchor: (Height: 18);
            }
          }
        }

        // Divider 2-3
        Group #Divider2 {
          Anchor: (Height: 1);
          Background: (Color: @DividerColor);
        }

        // Slot 3 (bottom)
        Group #ReqRow3 {
          LayoutMode: Left;
          Padding: (Top: 12, Bottom: 12);

          Group #ReqIconBox3 {
            Anchor: (Width: @MatSlotHeight, Height: @MatSlotHeight);
            LayoutMode: Middle;
            Background: (TexturePath: "Stash/Item/Weapon/Item.png");

            ItemIcon #ReqIcon3 {
              Anchor: (Width: @MatIconSize, Height: @MatIconSize);
            }
          }

          Group { Anchor: (Width: 18); }

          Group #ReqText3 {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #ReqName3 {
              Text: "Material Name";
              Style: (FontSize: 16, TextColor: @Black, RenderBold: true);
              Anchor: (Height: 20);
            }

            Group { Anchor: (Height: 6); }

            Label #ReqCount3 {
              Text: "0/1";
              Style: (FontSize: 15, TextColor: @Gray6);
              Anchor: (Height: 18);
            }
          }
        }

        // Quantity controls
        Group #QtyRow {
          LayoutMode: Top;

          Group { Anchor: (Height: 32); }

          Group #QtyControls {
            LayoutMode: Left;

            Group { FlexWeight: 1; }

            Button #QtyDec {
              Anchor: (Width: @QtyBtnWidth, Height: @QtyBtnHeight);
              Style: (Default: (Background: (Color: @QtyBtnBg)));
              Label {
                Text: "-";
                Style: (FontSize: 22, TextColor: @White, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }

            Group #QtyValBox {
              Anchor: (Width: @QtyValWidth, Height: @QtyBtnHeight);
              LayoutMode: Middle;
              Background: (Color: @QtyValBg);

              Label #QtyVal {
                Text: "1";
                Style: (FontSize: 22, TextColor: @Gray3, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }

            Button #QtyInc {
              Anchor: (Width: @QtyBtnWidth, Height: @QtyBtnHeight);
              Style: (Default: (Background: (Color: @QtyBtnBg)));
              Label {
                Text: "+";
                Style: (FontSize: 22, TextColor: @White, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
              }
            }

            Group { FlexWeight: 1; }
          }

          Group { Anchor: (Height: 20); }
        }

        // Craft button with custom background
        Button #CraftBtn {
          Anchor: (Height: @MainBtnHeight);
          Background: (TexturePath: "Workshop/CraftButton.png");

          Label {
            Text: "CRAFT";
            Style: (FontSize: 16, TextColor: @Black, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }
    }
    }

    // Empty state - only bottom bar visible until a workbench is selected
    Group #WorkshopEmpty {
      Anchor: (Height: 670);
      LayoutMode: Middle;
    }

    Group #WorkshopUpgradeView {
      Anchor: (Height: 670);
      LayoutMode: Left;
      Visible: false;

      Group #UpgradeLeftPanel {
        Anchor: (Width: @LeftWidth);
      }

      Group #UpgradeMiddlePanel {
        FlexWeight: 1;
        LayoutMode: Middle;
        Padding: (Left: (@Pad + 200), Right: (@Pad + 200));
        ItemIcon #UpgradeBenchIcon {
          Anchor: (Width: @PreviewSize, Height: @PreviewSize);
        }
      }

      Group #UpgradeRightPanel {
        Anchor: (Width: @RightWidth);
        LayoutMode: Middle;

        Group #UpgradeCard {
          Anchor: (Width: @RightWidth);
          LayoutMode: Top;
          Padding: (Left: @CardPad, Right: @CardPad, Top: @CardPad, Bottom: @CardPad);
          Background: (TexturePath: "Workshop/MaterialsBackground.png");

          Label #UpgradeTitle {
            Text: "UPGRADE TO TIER 2";
            Style: (FontSize: 28, TextColor: @Black, RenderBold: true, HorizontalAlignment: Center);
            Anchor: (Height: 36);
          }

          Group { Anchor: (Height: 20); }

          Label #UpgradeReqTitle {
            Text: "REQUIRED RESOURCES";
            Style: (FontSize: 14, TextColor: @Gray3, RenderBold: true);
            Anchor: (Height: 20);
          }

          Group { Anchor: (Height: 10); }

          Group #UpgradeReqRow0 {
            LayoutMode: Left;
            Padding: (Top: 10, Bottom: 10);
            Group #UpgradeReqIconBox0 {
              Anchor: (Width: @MatSlotHeight, Height: @MatSlotHeight);
              LayoutMode: Middle;
              Background: (TexturePath: "Stash/Item/Weapon/Item.png");
              ItemIcon #UpgradeReqIcon0 { Anchor: (Width: @MatIconSize, Height: @MatIconSize); }
            }
            Group { Anchor: (Width: 16); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;
              Label #UpgradeReqName0 { Text: "Material"; Style: (FontSize: 16, TextColor: @Black, RenderBold: true); Anchor: (Height: 20); }
              Group { Anchor: (Height: 4); }
              Label #UpgradeReqCount0 { Text: "0/0"; Style: (FontSize: 15, TextColor: @Gray6); Anchor: (Height: 18); }
            }
          }

          Group #UpgradeReqRow1 {
            LayoutMode: Left;
            Padding: (Top: 10, Bottom: 10);
            Group #UpgradeReqIconBox1 {
              Anchor: (Width: @MatSlotHeight, Height: @MatSlotHeight);
              LayoutMode: Middle;
              Background: (TexturePath: "Stash/Item/Weapon/Item.png");
              ItemIcon #UpgradeReqIcon1 { Anchor: (Width: @MatIconSize, Height: @MatIconSize); }
            }
            Group { Anchor: (Width: 16); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;
              Label #UpgradeReqName1 { Text: "Material"; Style: (FontSize: 16, TextColor: @Black, RenderBold: true); Anchor: (Height: 20); }
              Group { Anchor: (Height: 4); }
              Label #UpgradeReqCount1 { Text: "0/0"; Style: (FontSize: 15, TextColor: @Gray6); Anchor: (Height: 18); }
            }
          }

          Group #UpgradeReqRow2 {
            LayoutMode: Left;
            Padding: (Top: 10, Bottom: 10);
            Group #UpgradeReqIconBox2 {
              Anchor: (Width: @MatSlotHeight, Height: @MatSlotHeight);
              LayoutMode: Middle;
              Background: (TexturePath: "Stash/Item/Weapon/Item.png");
              ItemIcon #UpgradeReqIcon2 { Anchor: (Width: @MatIconSize, Height: @MatIconSize); }
            }
            Group { Anchor: (Width: 16); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;
              Label #UpgradeReqName2 { Text: "Material"; Style: (FontSize: 16, TextColor: @Black, RenderBold: true); Anchor: (Height: 20); }
              Group { Anchor: (Height: 4); }
              Label #UpgradeReqCount2 { Text: "0/0"; Style: (FontSize: 15, TextColor: @Gray6); Anchor: (Height: 18); }
            }
          }

          Group #UpgradeReqRow3 {
            LayoutMode: Left;
            Padding: (Top: 10, Bottom: 10);
            Group #UpgradeReqIconBox3 {
              Anchor: (Width: @MatSlotHeight, Height: @MatSlotHeight);
              LayoutMode: Middle;
              Background: (TexturePath: "Stash/Item/Weapon/Item.png");
              ItemIcon #UpgradeReqIcon3 { Anchor: (Width: @MatIconSize, Height: @MatIconSize); }
            }
            Group { Anchor: (Width: 16); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;
              Label #UpgradeReqName3 { Text: "Material"; Style: (FontSize: 16, TextColor: @Black, RenderBold: true); Anchor: (Height: 20); }
              Group { Anchor: (Height: 4); }
              Label #UpgradeReqCount3 { Text: "0/0"; Style: (FontSize: 15, TextColor: @Gray6); Anchor: (Height: 18); }
            }
          }

          Group { Anchor: (Height: 20); }

          Button #UpgradeBtn {
            Anchor: (Height: @MainBtnHeight);
            Background: (TexturePath: "Workshop/CraftButton.png");
            Label #UpgradeBtnLabel {
              Text: "UPGRADE TO TIER 2";
              Style: (FontSize: 16, TextColor: @Black, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
      }
    }

    Group { Anchor: (Height: 0); }

    // WORKBENCH NAVIGATION


    Group #WorkbenchNav {
      Visible: false;
      LayoutMode: Left;

      Group { FlexWeight: 1; }

      Button #WbWorkbench {
        Anchor: (Width: @WbBtnSize, Height: @WbBtnSize);
        TooltipText: "Workbench";
        Background: (TexturePath: "Workshop/ItemSlotUnselected.png");
        Group #Selected {
          Visible: false;
          Anchor: (Full: 0);
          Background: (TexturePath: "Workshop/ItemSlotSelected.png");
        }
        ItemIcon #WbWorkbenchIcon {
          Anchor: (Full: 0);
          ItemId: "Workshop_Workbench";
        }
      }

      Group { Anchor: (Width: @WbBtnGap); }

      Button #WbAlchemyTable {
        Anchor: (Width: @WbBtnSize, Height: @WbBtnSize);
        TooltipText: "Alchemy Table";
        Background: (TexturePath: "Workshop/ItemSlotUnselected.png");
        Group #Selected {
          Visible: false;
          Anchor: (Full: 0);
          Background: (TexturePath: "Workshop/ItemSlotSelected.png");
        }
        ItemIcon #WbAlchemyTableIcon {
          Anchor: (Full: 0);
          ItemId: "Workshop_AlchemyTable";
        }
      }

      Group { Anchor: (Width: @WbBtnGap); }

      Button #WbDemolitionsTable {
        Anchor: (Width: @WbBtnSize, Height: @WbBtnSize);
        TooltipText: "Furnace";
        Background: (TexturePath: "Workshop/ItemSlotUnselected.png");
        Group #Selected {
          Visible: false;
          Anchor: (Full: 0);
          Background: (TexturePath: "Workshop/ItemSlotSelected.png");
        }
        ItemIcon #WbDemolitionsTableIcon {
          Anchor: (Full: 0);
          ItemId: "Workshop_Furnace";
        }
      }

      Group { Anchor: (Width: @WbBtnGap); }

      Button #WbUtilityBench {
        Anchor: (Width: @WbBtnSize, Height: @WbBtnSize);
        TooltipText: "Utility Bench";
        Background: (TexturePath: "Workshop/ItemSlotUnselected.png");
        Group #Selected {
          Visible: false;
          Anchor: (Full: 0);
          Background: (TexturePath: "Workshop/ItemSlotSelected.png");
        }
        ItemIcon #WbUtilityBenchIcon {
          Anchor: (Full: 0);
          ItemId: "Workshop_UtilityBench";
        }
      }

      Group { Anchor: (Width: @WbBtnGap); }

      Button #WbWeaponsForge {
        Anchor: (Width: @WbBtnSize, Height: @WbBtnSize);
        TooltipText: "Weapons Forge";
        Background: (TexturePath: "Workshop/ItemSlotUnselected.png");
        Group #Selected {
          Visible: false;
          Anchor: (Full: 0);
          Background: (TexturePath: "Workshop/ItemSlotSelected.png");
        }
        ItemIcon #WbWeaponsForgeIcon {
          Anchor: (Full: 0);
          ItemId: "Workshop_WeaponsForge";
        }
      }

      Group { FlexWeight: 1; }
    }
  }
}






