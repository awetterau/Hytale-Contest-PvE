Group #NpcQuestRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;
  Background: #000000(0.0);

  Group #Panel {
    Anchor: (Width: 1300, Height: 760);
    LayoutMode: Top;
    Padding: (Left: 24, Right: 24, Top: 22, Bottom: 20);
    Background: #060b14(1.0);

    Label #QuestHeader {
      Text: "Quest Board";
      Anchor: (Height: 40, Bottom: 14);
      Style: (FontSize: 30, TextColor: #f3f8ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Left;

      Group {
        FlexWeight: 52;
        Anchor: (Top: 0, Bottom: 0);
        LayoutMode: Top;
        Background: #091120(0.9);
        Padding: (Left: 22, Right: 22, Top: 22, Bottom: 22);

        Label #QuestTitle {
          Text: "No quests";
          Anchor: (Height: 44, Bottom: 14);
          Style: (FontSize: 36, TextColor: #f6f1e5, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Label #QuestSummary {
          Text: "";
          FlexWeight: 1;
          Style: (FontSize: 16, TextColor: #d2d8df, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
        }
      }

      Group { FlexWeight: 1; }

      Group {
        FlexWeight: 47;
        Anchor: (Top: 0, Bottom: 0);
        LayoutMode: Top;
        Background: (TexturePath: "Workshop/MaterialsBackground.png");
        Padding: (Left: 24, Right: 24, Top: 24, Bottom: 24);

        Label {
          Text: "STATUS";
          Anchor: (Height: 24, Bottom: 8);
          Style: (FontSize: 20, TextColor: #222222, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Label #QuestStatus {
          Text: "Status: Unavailable";
          Anchor: (Height: 72, Bottom: 18);
          Style: (FontSize: 16, TextColor: #444444, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
        }

        Group #QuestProgressSection {
          LayoutMode: Top;
          Anchor: (Height: 206, Bottom: 18);

          Label #QuestProgressHeader {
            Text: "PROGRESS";
            Anchor: (Height: 24, Bottom: 8);
            Style: (FontSize: 20, TextColor: #222222, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
          }

          Group #MissionProgressGroup {
            LayoutMode: Top;
            Anchor: (Height: 48, Bottom: 8);

            Label #MissionProgressLabel {
              Text: "Missions extracted: 0/0";
              Anchor: (Height: 20, Bottom: 6);
              Style: (FontSize: 14, TextColor: #444444, HorizontalAlignment: Start, VerticalAlignment: Center);
            }

            ProgressBar #MissionProgressBar {
              Value: 0.0;
              Anchor: (Height: 20);
              Background: #2a2a2a(0.45);
              OutlineColor: #111111;
              OutlineSize: 1;
              Bar: #315f96(1.0);
            }
          }

          Group #BeastProgressGroup {
            LayoutMode: Top;
            Anchor: (Height: 48, Bottom: 8);

            Label #BeastProgressLabel {
              Text: "Blight Beasts slain: 0/0";
              Anchor: (Height: 20, Bottom: 6);
              Style: (FontSize: 14, TextColor: #444444, HorizontalAlignment: Start, VerticalAlignment: Center);
            }

            ProgressBar #BeastProgressBar {
              Value: 0.0;
              Anchor: (Height: 20);
              Background: #2a2a2a(0.45);
              OutlineColor: #111111;
              OutlineSize: 1;
              Bar: #8b1e24(1.0);
            }
          }

          Label #QuestProgressText {
            Text: "";
            Anchor: (Height: 62);
            Style: (FontSize: 15, TextColor: #444444, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
          }
        }

        Label {
          Text: "ACTIONS";
          Anchor: (Height: 24, Bottom: 12);
          Style: (FontSize: 20, TextColor: #222222, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40, Bottom: 8);
          Button #PrevQuestBtn {
            Anchor: (Width: 95, Height: 36, Right: 8);
            Label { Text: "Prev"; Style: (FontSize: 14, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
          }
          Button #NextQuestBtn {
            Anchor: (Width: 95, Height: 36);
            Label { Text: "Next"; Style: (FontSize: 14, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
          }
        }

        Button #AcceptQuestBtn {
          Anchor: (Height: 44, Bottom: 8);
          Style: (
            Default: (Background: #2f6b3a),
            Hovered: (Background: #398447),
            Pressed: (Background: #275730)
          );
          Label { Text: "Accept"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
        }

        Button #CompleteQuestBtn {
          Anchor: (Height: 44, Bottom: 8);
          Style: (
            Default: (Background: #5a4e1f),
            Hovered: (Background: #766528),
            Pressed: (Background: #4a3f18)
          );
          Label { Text: "Complete"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
        }

        Group { FlexWeight: 1; }

        Button #BackBtn {
          Anchor: (Height: 44);
          Style: (
            Default: (Background: #2f3f54),
            Hovered: (Background: #3e536d),
            Pressed: (Background: #263448)
          );
          Label { Text: "Back"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
        }
      }
    }
  }
}
