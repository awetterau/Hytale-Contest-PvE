Group #NpcQuestRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 980, Height: 560);
    Background: (Color: #0a1320(0.97));
    OutlineColor: #6c84a2;
    OutlineSize: 1;
    Padding: (Full: 18);
    LayoutMode: Top;

    Label #QuestHeader {
      Text: "Quest Board";
      Anchor: (Height: 36, Bottom: 10);
      Style: (FontSize: 26, TextColor: #f3f8ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Label #QuestTitle {
      Text: "No quests";
      Anchor: (Height: 34, Bottom: 8);
      Style: (FontSize: 21, TextColor: #f3c17f, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Label #QuestSummary {
      Text: "";
      Anchor: (Height: 110, Bottom: 12);
      Style: (FontSize: 16, TextColor: #dce9fb, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
    }

    Label #QuestStatus {
      Text: "Status: Unavailable";
      Anchor: (Height: 28, Bottom: 12);
      Style: (FontSize: 15, TextColor: #b8d4f7, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 42, Bottom: 10);
      Button #PrevQuestBtn {
        Anchor: (Width: 120, Height: 38, Right: 8);
        Label { Text: "Prev"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #NextQuestBtn {
        Anchor: (Width: 120, Height: 38, Right: 8);
        Label { Text: "Next"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #AcceptQuestBtn {
        Anchor: (Width: 140, Height: 38, Right: 8);
        Label { Text: "Accept"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #CompleteQuestBtn {
        Anchor: (Width: 140, Height: 38, Right: 8);
        Label { Text: "Complete"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #BackBtn {
        Anchor: (Width: 120, Height: 38);
        Label { Text: "Back"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }
  }
}
