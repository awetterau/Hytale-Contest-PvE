Group #QuestRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 960, Height: 560);
    Background: (Color: #0a1320(0.97));
    OutlineColor: #6c84a2;
    OutlineSize: 1;
    Padding: (Full: 18);
    LayoutMode: Top;

    Label {
      Text: "Quest Board: Ironbound Contracts";
      Anchor: (Height: 36, Bottom: 10);
      Style: (FontSize: 26, TextColor: #f3f8ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Label {
      Text: "Choose your contract and return with proof to unlock advanced forge upgrades.";
      Anchor: (Height: 44, Bottom: 10);
      Style: (FontSize: 15, TextColor: #c8daf2, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
    }

    Group #QuestCard {
      Anchor: (Width: 900, Height: 300, Bottom: 14);
      Background: (Color: #121f31);
      OutlineColor: #5b7391;
      OutlineSize: 1;
      Padding: (Full: 14);
      LayoutMode: Top;

      Label {
        Text: "EMERGENCY CONTRACT: Ember Core Hunt";
        Anchor: (Height: 30, Bottom: 8);
        Style: (FontSize: 20, TextColor: #f3c17f, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label {
        Text: "Threat Level: High";
        Anchor: (Height: 24, Bottom: 6);
        Style: (FontSize: 15, TextColor: #ffcc9d, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label {
        Text: "Objectives:";
        Anchor: (Height: 24, Bottom: 4);
        Style: (FontSize: 16, TextColor: #dce9fb, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label {
        Text: "- Bring Iron Ingot x20";
        Anchor: (Height: 22, Bottom: 2);
        Style: (FontSize: 15, TextColor: #dce9fb, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label {
        Text: "- Kill Crimson Warden x1";
        Anchor: (Height: 22, Bottom: 2);
        Style: (FontSize: 15, TextColor: #dce9fb, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label {
        Text: "- Retrieve Ember Core x1";
        Anchor: (Height: 22, Bottom: 8);
        Style: (FontSize: 15, TextColor: #dce9fb, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label {
        Text: "Reward: Unlock 'Tempered Vanguard' recipes + Workshop Level II permit.";
        Anchor: (Height: 42);
        Style: (FontSize: 15, TextColor: #b8d4f7, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
      }
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 42);
      Button #AcceptQuestBtn {
        Anchor: (Width: 160, Height: 38, Right: 8);
        Style: (
          Default: (Background: (Color: #2f6b3a)),
          Hovered: (Background: (Color: #398447)),
          Pressed: (Background: (Color: #275730))
        );
        Label { Text: "Accept"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #TrackQuestBtn {
        Anchor: (Width: 160, Height: 38, Right: 8);
        Style: (
          Default: (Background: (Color: #425d7c)),
          Hovered: (Background: (Color: #4f7196)),
          Pressed: (Background: (Color: #364d68))
        );
        Label { Text: "Track Quest"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #BackBtn {
        Anchor: (Width: 120, Height: 38);
        Style: (
          Default: (Background: (Color: #2f3f54)),
          Hovered: (Background: (Color: #3e536d)),
          Pressed: (Background: (Color: #263448))
        );
        Label { Text: "Back"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }
  }
}
