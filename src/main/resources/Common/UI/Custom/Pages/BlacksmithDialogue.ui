Group #BlacksmithDialogueRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Bottom;
  Padding: (Bottom: 30);

  Group #DialoguePanel {
    Anchor: (Width: 980, Height: 200);
    Background: (Color: #0b0f16(0.94));
    OutlineColor: #60738f;
    OutlineSize: 1;
    Padding: (Left: 22, Right: 22, Top: 18, Bottom: 16);
    LayoutMode: Top;

    Label #NpcName {
      Text: "Blacksmith";
      Anchor: (Height: 30, Bottom: 8);
      Style: (
        FontSize: 22,
        TextColor: #f0c57b,
        RenderBold: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Label #DialogueText {
      Text: "Workshop is running. What do you need?";
      Anchor: (Bottom: 14);
      Style: (
        FontSize: 20,
        TextColor: #e6edf8,
        Wrap: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Start
      );
      FlexWeight: 1;
    }

    Group #ActionRow {
      LayoutMode: Right;
      Anchor: (Height: 42, Bottom: 8);

      Button #CraftButton {
        Anchor: (Width: 128, Height: 38, Right: 8);
        Style: (
          Default: (Background: (Color: #425d7c)),
          Hovered: (Background: (Color: #4f7196)),
          Pressed: (Background: (Color: #364d68))
        );
        Label {
          Text: "Craft";
          Style: (
            FontSize: 16,
            TextColor: #f0f4ff,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }

      Button #UpgradesButton {
        Anchor: (Width: 128, Height: 38, Right: 8);
        Style: (
          Default: (Background: (Color: #4d5f30)),
          Hovered: (Background: (Color: #5e7640)),
          Pressed: (Background: (Color: #414f29))
        );
        Label {
          Text: "Upgrades";
          Style: (
            FontSize: 16,
            TextColor: #f0f4ff,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }

      Button #QuestsButton {
        Anchor: (Width: 128, Height: 38, Right: 8);
        Style: (
          Default: (Background: (Color: #73563a)),
          Hovered: (Background: (Color: #8a6846)),
          Pressed: (Background: (Color: #5f4730))
        );
        Label {
          Text: "Quests";
          Style: (
            FontSize: 16,
            TextColor: #f0f4ff,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }

      Button #CloseButton {
        Anchor: (Width: 110, Height: 38);
        Style: (
          Default: (Background: (Color: #2f3f54)),
          Hovered: (Background: (Color: #3e536d)),
          Pressed: (Background: (Color: #263448))
        );

        Label {
          Text: "Close";
          Style: (
            FontSize: 16,
            TextColor: #f0f4ff,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }
    }
  }
}
