Group #BasePlotTerminalRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 720, Height: 440);
    Background: (Color: #0b1220(0.94));
    OutlineColor: #637892;
    OutlineSize: 1;
    Padding: (Full: 18);
    LayoutMode: Top;

    Label #Title {
      Text: "Plot Terminal";
      Anchor: (Height: 36, Bottom: 12);
      Style: (
        FontSize: 24,
        TextColor: #f2f7ff,
        RenderBold: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Label #Status {
      Text: "Select plot:";
      Anchor: (Height: 48, Bottom: 12);
      Style: (
        FontSize: 17,
        TextColor: #d7e4f7,
        Wrap: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Start
      );
    }

    Group #PlotList {
      LayoutMode: Top;
      Anchor: (Height: 256, Bottom: 14);

      Button #PlotBtn1 {
        Anchor: (Width: 300, Height: 40, Bottom: 6);
        Style: (Default: (Background: (Color: #33465f)), Hovered: (Background: (Color: #3f5775)), Pressed: (Background: (Color: #2a3c53)));
        Label #PlotBtn1Text { Text: "Plot 1"; Style: (FontSize: 16, TextColor: #f2f6ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #PlotBtn2 {
        Anchor: (Width: 300, Height: 40, Bottom: 6);
        Style: (Default: (Background: (Color: #33465f)), Hovered: (Background: (Color: #3f5775)), Pressed: (Background: (Color: #2a3c53)));
        Label #PlotBtn2Text { Text: "Plot 2"; Style: (FontSize: 16, TextColor: #f2f6ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #PlotBtn3 {
        Anchor: (Width: 300, Height: 40, Bottom: 6);
        Style: (Default: (Background: (Color: #33465f)), Hovered: (Background: (Color: #3f5775)), Pressed: (Background: (Color: #2a3c53)));
        Label #PlotBtn3Text { Text: "Plot 3"; Style: (FontSize: 16, TextColor: #f2f6ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #PlotBtn4 {
        Anchor: (Width: 300, Height: 40, Bottom: 6);
        Style: (Default: (Background: (Color: #33465f)), Hovered: (Background: (Color: #3f5775)), Pressed: (Background: (Color: #2a3c53)));
        Label #PlotBtn4Text { Text: "Plot 4"; Style: (FontSize: 16, TextColor: #f2f6ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #PlotBtn5 {
        Anchor: (Width: 300, Height: 40, Bottom: 6);
        Style: (Default: (Background: (Color: #33465f)), Hovered: (Background: (Color: #3f5775)), Pressed: (Background: (Color: #2a3c53)));
        Label #PlotBtn5Text { Text: "Plot 5"; Style: (FontSize: 16, TextColor: #f2f6ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #PlotBtn6 {
        Anchor: (Width: 300, Height: 40, Bottom: 6);
        Style: (Default: (Background: (Color: #33465f)), Hovered: (Background: (Color: #3f5775)), Pressed: (Background: (Color: #2a3c53)));
        Label #PlotBtn6Text { Text: "Plot 6"; Style: (FontSize: 16, TextColor: #f2f6ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #PlotBtn7 {
        Anchor: (Width: 300, Height: 40, Bottom: 6);
        Style: (Default: (Background: (Color: #33465f)), Hovered: (Background: (Color: #3f5775)), Pressed: (Background: (Color: #2a3c53)));
        Label #PlotBtn7Text { Text: "Plot 7"; Style: (FontSize: 16, TextColor: #f2f6ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #PlotBtn8 {
        Anchor: (Width: 300, Height: 40, Bottom: 6);
        Style: (Default: (Background: (Color: #33465f)), Hovered: (Background: (Color: #3f5775)), Pressed: (Background: (Color: #2a3c53)));
        Label #PlotBtn8Text { Text: "Plot 8"; Style: (FontSize: 16, TextColor: #f2f6ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 42);
      Button #CloseBtn {
        Anchor: (Width: 120, Height: 40);
        Style: (
          Default: (Background: (Color: #2f3f54)),
          Hovered: (Background: (Color: #3e536d)),
          Pressed: (Background: (Color: #263448))
        );
        Label {
          Text: "Close";
          Style: (
            FontSize: 16,
            TextColor: #f0f4ff,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }
    }
  }
}
