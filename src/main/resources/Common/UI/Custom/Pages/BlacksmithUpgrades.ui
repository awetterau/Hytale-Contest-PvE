Group #UpgradesRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 820, Height: 420);
    Background: (Color: #0d1724(0.97));
    OutlineColor: #6f87a4;
    OutlineSize: 1;
    Padding: (Full: 16);
    LayoutMode: Top;

    Label {
      Text: "Workshop Upgrades";
      Anchor: (Height: 34, Bottom: 8);
      Style: (FontSize: 24, TextColor: #f2f7ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
    Label {
      Text: "Current Level: 1";
      Anchor: (Height: 24, Bottom: 8);
      Style: (FontSize: 16, TextColor: #d4e5fb, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
    Label {
      Text: "Next unlock: Tempered weapon recipes and +1 quest slot.";
      Anchor: (Height: 48, Bottom: 10);
      Style: (FontSize: 15, TextColor: #c4d8f5, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 42);
      Button #UpgradeBtn {
        Anchor: (Width: 190, Height: 38, Right: 8);
        Style: (
          Default: (Background: (Color: #72501f)),
          Hovered: (Background: (Color: #8a6326)),
          Pressed: (Background: (Color: #5f431a))
        );
        Label { Text: "Upgrade Workshop"; Style: (FontSize: 15, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #BackBtn {
        Anchor: (Width: 120, Height: 38);
        Style: (
          Default: (Background: (Color: #2f3f54)),
          Hovered: (Background: (Color: #3e536d)),
          Pressed: (Background: (Color: #263448))
        );
        Label { Text: "Back"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }
  }
}
