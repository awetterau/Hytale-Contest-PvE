Group #UpgradesRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;
  Background: #000000(0.0);

  Group #Panel {
    Anchor: (Width: 1700, Height: 880);
    LayoutMode: Top;
    Padding: (Left: 50, Right: 50, Bottom: 50);

    Group #TopControls {
      Anchor: (Height: 48);
      LayoutMode: Right;

      Button #BackBtn {
        Anchor: (Width: 140, Height: 44);
        Style: (
          Default: (Background: #1e2d3f(0.95)),
          Hovered: (Background: #2a3d54(0.95)),
          Pressed: (Background: #172434(0.95))
        );
        Label {
          Text: "BACK";
          Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }

    Group { Anchor: (Height: 10); }

    Group {
      Anchor: (Height: 670);
      LayoutMode: Left;

      Group {
        Anchor: (Width: 460);
      }

      Group #UpgradeMiddlePanel {
        FlexWeight: 1;
        LayoutMode: Middle;
        Padding: (Left: 250, Right: 250);
      }

      Group {
        Anchor: (Width: 430);
        LayoutMode: Middle;

        Group {
          Anchor: (Width: 430);
          LayoutMode: Top;
          Padding: (Left: 36, Right: 36, Top: 36, Bottom: 36);
          Background: (TexturePath: "Workshop/MaterialsBackground.png");

          Label #UpgradeTitle {
            Text: "UPGRADE";
            Style: (FontSize: 28, TextColor: #1a1a1a, RenderBold: true, HorizontalAlignment: Center);
            Anchor: (Height: 36);
          }

          Group { Anchor: (Height: 20); }

          Label {
            Text: "REQUIRED RESOURCES";
            Style: (FontSize: 14, TextColor: #333333, RenderBold: true);
            Anchor: (Height: 20);
          }

          Group { Anchor: (Height: 10); }

          Group #UpgradeReqRow0 {
            LayoutMode: Left;
            Padding: (Top: 10, Bottom: 10);
            Group {
              Anchor: (Width: 70, Height: 70);
              LayoutMode: Middle;
              Background: (TexturePath: "Stash/Item/Weapon/Item.png");
              ItemIcon #UpgradeReqIcon0 { Anchor: (Width: 46, Height: 46); }
            }
            Group { Anchor: (Width: 16); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;
              Label #UpgradeReqName0 { Text: "Material"; Style: (FontSize: 16, TextColor: #1a1a1a, RenderBold: true); Anchor: (Height: 20); }
              Group { Anchor: (Height: 4); }
              Label #UpgradeReqCount0 { Text: "0/0"; Style: (FontSize: 15, TextColor: #666666); Anchor: (Height: 18); }
            }
          }

          Group #UpgradeReqRow1 {
            LayoutMode: Left;
            Padding: (Top: 10, Bottom: 10);
            Group {
              Anchor: (Width: 70, Height: 70);
              LayoutMode: Middle;
              Background: (TexturePath: "Stash/Item/Weapon/Item.png");
              ItemIcon #UpgradeReqIcon1 { Anchor: (Width: 46, Height: 46); }
            }
            Group { Anchor: (Width: 16); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;
              Label #UpgradeReqName1 { Text: "Material"; Style: (FontSize: 16, TextColor: #1a1a1a, RenderBold: true); Anchor: (Height: 20); }
              Group { Anchor: (Height: 4); }
              Label #UpgradeReqCount1 { Text: "0/0"; Style: (FontSize: 15, TextColor: #666666); Anchor: (Height: 18); }
            }
          }

          Group #UpgradeReqRow2 {
            LayoutMode: Left;
            Padding: (Top: 10, Bottom: 10);
            Group {
              Anchor: (Width: 70, Height: 70);
              LayoutMode: Middle;
              Background: (TexturePath: "Stash/Item/Weapon/Item.png");
              ItemIcon #UpgradeReqIcon2 { Anchor: (Width: 46, Height: 46); }
            }
            Group { Anchor: (Width: 16); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;
              Label #UpgradeReqName2 { Text: "Material"; Style: (FontSize: 16, TextColor: #1a1a1a, RenderBold: true); Anchor: (Height: 20); }
              Group { Anchor: (Height: 4); }
              Label #UpgradeReqCount2 { Text: "0/0"; Style: (FontSize: 15, TextColor: #666666); Anchor: (Height: 18); }
            }
          }

          Group #UpgradeReqRow3 {
            LayoutMode: Left;
            Padding: (Top: 10, Bottom: 10);
            Group {
              Anchor: (Width: 70, Height: 70);
              LayoutMode: Middle;
              Background: (TexturePath: "Stash/Item/Weapon/Item.png");
              ItemIcon #UpgradeReqIcon3 { Anchor: (Width: 46, Height: 46); }
            }
            Group { Anchor: (Width: 16); }
            Group {
              FlexWeight: 1;
              LayoutMode: Top;
              Label #UpgradeReqName3 { Text: "Material"; Style: (FontSize: 16, TextColor: #1a1a1a, RenderBold: true); Anchor: (Height: 20); }
              Group { Anchor: (Height: 4); }
              Label #UpgradeReqCount3 { Text: "0/0"; Style: (FontSize: 15, TextColor: #666666); Anchor: (Height: 18); }
            }
          }

          Group { Anchor: (Height: 20); }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 40, Bottom: 8);
            Button #PrevUpgradeBtn {
              Anchor: (Width: 90, Height: 36, Right: 8);
              Label { Text: "Prev"; Style: (FontSize: 14, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
            }
            Button #NextUpgradeBtn {
              Anchor: (Width: 90, Height: 36);
              Label { Text: "Next"; Style: (FontSize: 14, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
            }
          }

          Button #UpgradeBtn {
            Anchor: (Height: 60);
            Background: (TexturePath: "Workshop/CraftButton.png");
            Label #UpgradeBtnLabel {
              Text: "UPGRADE";
              Style: (FontSize: 16, TextColor: #111111, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
      }
    }
  }
}
