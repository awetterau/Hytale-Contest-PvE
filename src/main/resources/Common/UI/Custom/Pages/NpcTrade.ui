Group #NpcTradeRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 900, Height: 420);
    Background: (Color: #0c121d(0.97));
    OutlineColor: #7f94ae;
    OutlineSize: 1;
    Padding: (Full: 18);
    LayoutMode: Top;

    Label #TradeHeader {
      Text: "Trade Offers";
      Anchor: (Height: 34, Bottom: 10);
      Style: (FontSize: 26, TextColor: #f2f7ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Label #TradeIdText {
      Text: "No trade unlocks yet.";
      Anchor: (Height: 80, Bottom: 14);
      Style: (FontSize: 17, TextColor: #d3e1f6, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 42);
      Button #PrevTradeBtn {
        Anchor: (Width: 120, Height: 38, Right: 8);
        Label { Text: "Prev"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #NextTradeBtn {
        Anchor: (Width: 120, Height: 38, Right: 8);
        Label { Text: "Next"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #BuyBtn {
        Anchor: (Width: 150, Height: 38, Right: 8);
        Label { Text: "Execute Trade"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #BackBtn {
        Anchor: (Width: 120, Height: 38);
        Label { Text: "Back"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }
  }
}
