Group #NpcAdminHomeRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 1020, Height: 690);
    Background: (Color: #101a27(0.97));
    OutlineColor: #8aa1bd;
    OutlineSize: 1;
    Padding: (Full: 18);
    LayoutMode: Top;

    Label #Title {
      Text: "NPC Admin";
      Anchor: (Height: 38, Bottom: 8);
      Style: (FontSize: 28, TextColor: #eef5ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Label {
      Text: "Pick an NPC, then open the detail page to change rescue state, behavior, or spawn overrides.";
      Anchor: (Height: 24, Bottom: 10);
      Style: (FontSize: 14, TextColor: #9fb2ca, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Group #SelectedCard {
      Anchor: (Height: 110, Bottom: 14);
      Background: (Color: #162334(0.95));
      OutlineColor: #51647c;
      OutlineSize: 1;
      Padding: (Full: 14);
      LayoutMode: Top;

      Label #SelectedLabel {
        Text: "No NPC selected";
        Anchor: (Height: 28, Bottom: 6);
        Style: (FontSize: 22, TextColor: #f1f6ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #SelectedMeta {
        Text: "Meta";
        Anchor: (Height: 22, Bottom: 6);
        Style: (FontSize: 14, TextColor: #a8bdd7, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #SelectedState {
        Text: "State";
        Anchor: (Height: 22);
        Style: (FontSize: 15, TextColor: #dce8f6, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
    }

    Group #ListCard {
      Anchor: (Height: 410, Bottom: 14);
      Background: (Color: #122031(0.92));
      OutlineColor: #4f627a;
      OutlineSize: 1;
      Padding: (Full: 14);
      LayoutMode: Top;

      Label {
        Text: "Registered NPCs";
        Anchor: (Height: 24, Bottom: 8);
        Style: (FontSize: 18, TextColor: #eff5ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #Summary {
        Text: "Summary";
        Anchor: (Height: 340);
        Style: (FontSize: 15, TextColor: #e1ebf8, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
      }
    }

    Group #Buttons {
      LayoutMode: Right;
      Anchor: (Height: 44, Bottom: 10);
      Button #PrevBtn { Anchor: (Width: 120, Height: 40, Right: 8); Style: (Default: (Background: (Color: #29384a)), Hovered: (Background: (Color: #33485f)), Pressed: (Background: (Color: #223041))); Label { Text: "Previous"; Style: (FontSize: 15, TextColor: #f1f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #NextBtn { Anchor: (Width: 120, Height: 40, Right: 8); Style: (Default: (Background: (Color: #29384a)), Hovered: (Background: (Color: #33485f)), Pressed: (Background: (Color: #223041))); Label { Text: "Next"; Style: (FontSize: 15, TextColor: #f1f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #OpenBtn { Anchor: (Width: 190, Height: 40, Right: 8); Style: (Default: (Background: (Color: #8b5e2b)), Hovered: (Background: (Color: #a06d32)), Pressed: (Background: (Color: #744e23))); Label { Text: "Open Controls"; Style: (FontSize: 15, TextColor: #fff7ea, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #RefreshBtn { Anchor: (Width: 120, Height: 40, Right: 8); Style: (Default: (Background: (Color: #1d5b59)), Hovered: (Background: (Color: #246d6a)), Pressed: (Background: (Color: #184947))); Label { Text: "Refresh"; Style: (FontSize: 15, TextColor: #ecfffd, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #CloseBtn { Anchor: (Width: 120, Height: 40); Style: (Default: (Background: (Color: #3a2f45)), Hovered: (Background: (Color: #4a3b58)), Pressed: (Background: (Color: #2d2435))); Label { Text: "Close"; Style: (FontSize: 15, TextColor: #f6efff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }
  }
}
