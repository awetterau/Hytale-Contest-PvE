Group #DevAdminRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 860, Height: 620);
    Background: (Color: #0b1220(0.96));
    OutlineColor: #637892;
    OutlineSize: 1;
    Padding: (Full: 16);
    LayoutMode: Top;

    Label #Title {
      Text: "Dev Admin Panel";
      Anchor: (Height: 34, Bottom: 8);
      Style: (
        FontSize: 24,
        TextColor: #f2f7ff,
        RenderBold: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Label #Status {
      Text: "Status";
      Anchor: (Height: 250, Bottom: 12);
      Style: (
        FontSize: 15,
        TextColor: #d7e4f7,
        Wrap: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Start
      );
    }

    Group #ButtonsA {
      LayoutMode: Right;
      Anchor: (Height: 44, Bottom: 8);

      Button #ResetFlowBtn { Anchor: (Width: 160, Height: 40, Right: 8); OutlineColor: #93a9c5; OutlineSize: 1; Label { Text: "1) Reset Flow"; Style: (FontSize: 14, TextColor: #f2f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #SetupPlotBtn { Anchor: (Width: 190, Height: 40, Right: 8); OutlineColor: #93a9c5; OutlineSize: 1; Label { Text: "2) Setup Plot Here"; Style: (FontSize: 14, TextColor: #f2f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #RescuedTrueBtn { Anchor: (Width: 170, Height: 40, Right: 8); OutlineColor: #93a9c5; OutlineSize: 1; Label { Text: "3) Rescued TRUE"; Style: (FontSize: 14, TextColor: #f2f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #PurchaseBtn { Anchor: (Width: 180, Height: 40); OutlineColor: #93a9c5; OutlineSize: 1; Label { Text: "4) Purchase Plot"; Style: (FontSize: 14, TextColor: #f2f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }

    Group #ButtonsB {
      LayoutMode: Right;
      Anchor: (Height: 44, Bottom: 8);

      Button #RescuedFalseBtn { Anchor: (Width: 170, Height: 40, Right: 8); OutlineColor: #93a9c5; OutlineSize: 1; Label { Text: "Rescued FALSE"; Style: (FontSize: 14, TextColor: #f2f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #SetWorkingBtn { Anchor: (Width: 170, Height: 40, Right: 8); OutlineColor: #93a9c5; OutlineSize: 1; Label { Text: "Force WORKING"; Style: (FontSize: 14, TextColor: #f2f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #OpenTerminalBtn { Anchor: (Width: 220, Height: 40, Right: 8); OutlineColor: #93a9c5; OutlineSize: 1; Label { Text: "Open Plot Terminal"; Style: (FontSize: 14, TextColor: #f2f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #RefreshBtn { Anchor: (Width: 120, Height: 40); OutlineColor: #93a9c5; OutlineSize: 1; Label { Text: "Refresh"; Style: (FontSize: 14, TextColor: #f2f6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }

    Group #ButtonsC {
      LayoutMode: Right;
      Anchor: (Height: 44, Bottom: 8);

      Button #FullNpcResetBtn { Anchor: (Width: 240, Height: 40); OutlineColor: #c59a93; OutlineSize: 1; Label { Text: "Full NPC Reset"; Style: (FontSize: 14, TextColor: #fff2f0, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 42);
      Button #CloseBtn {
        Anchor: (Width: 120, Height: 40);
        Style: (
          Default: (Background: (Color: #2f3f54)),
          Hovered: (Background: (Color: #3e536d)),
          Pressed: (Background: (Color: #263448))
        );
        Label {
          Text: "Close";
          Style: (
            FontSize: 16,
            TextColor: #f0f4ff,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }
    }
  }
}
