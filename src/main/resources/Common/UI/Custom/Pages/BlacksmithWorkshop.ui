Group #WorkshopRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 920, Height: 520);
    Background: (Color: #0c121d(0.97));
    OutlineColor: #7f94ae;
    OutlineSize: 1;
    Padding: (Full: 18);
    LayoutMode: Top;

    Label {
      Text: "Forge Workshop";
      Anchor: (Height: 34, Bottom: 10);
      Style: (FontSize: 26, TextColor: #f2f7ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Label {
      Text: "Crafting Station: Ironforge Bench";
      Anchor: (Height: 26, Bottom: 10);
      Style: (FontSize: 17, TextColor: #d3e1f6, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Group #RecipeCard {
      Anchor: (Width: 860, Height: 260, Bottom: 14);
      Background: (Color: #111d2d);
      OutlineColor: #5f7591;
      OutlineSize: 1;
      Padding: (Full: 14);
      LayoutMode: Top;

      Label {
        Text: "Recipe: Vanguard Sword";
        Anchor: (Height: 28, Bottom: 8);
        Style: (FontSize: 20, TextColor: #f6d7a3, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label {
        Text: "Materials:";
        Anchor: (Height: 24, Bottom: 6);
        Style: (FontSize: 16, TextColor: #dce8fa, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label {
        Text: "- Iron Ingot x12";
        Anchor: (Height: 22, Bottom: 2);
        Style: (FontSize: 15, TextColor: #dce8fa, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label {
        Text: "- Ancient Wood x6";
        Anchor: (Height: 22, Bottom: 2);
        Style: (FontSize: 15, TextColor: #dce8fa, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label {
        Text: "- Ember Core x1";
        Anchor: (Height: 22, Bottom: 10);
        Style: (FontSize: 15, TextColor: #dce8fa, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label {
        Text: "Effect: +12 damage, +5% critical chance";
        Anchor: (Height: 26);
        Style: (FontSize: 15, TextColor: #b8d2f4, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 42);
      Button #CraftSwordBtn {
        Anchor: (Width: 180, Height: 38, Right: 8);
        Style: (
          Default: (Background: (Color: #2f6b3a)),
          Hovered: (Background: (Color: #398447)),
          Pressed: (Background: (Color: #275730))
        );
        Label { Text: "Forge Item"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Button #BackBtn {
        Anchor: (Width: 120, Height: 38);
        Style: (
          Default: (Background: (Color: #2f3f54)),
          Hovered: (Background: (Color: #3e536d)),
          Pressed: (Background: (Color: #263448))
        );
        Label { Text: "Back"; Style: (FontSize: 16, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }
  }
}
