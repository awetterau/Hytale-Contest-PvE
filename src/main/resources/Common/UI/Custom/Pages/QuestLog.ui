    Group {
      Anchor: (Height: 44, Top: 14);
      LayoutMode: Left;

      Group { FlexWeight: 1; }

      Button #CloseBtn {
        Anchor: (Width: 110, Height: 36);
        Label { Text: "Close"; Style: (FontSize: 14, TextColor: #f0f4ff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
