$C = "../Common.ui";

Group #QuestLogRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;
  Background: #000000(0.8);

  Group #QuestLogPanel {
    Anchor: (Width: 1100, Height: 800);
    Background: #1a1512;
    OutlineColor: #4a3626;
    OutlineSize: 3;
    Padding: (Full: 24);
    LayoutMode: Top;

    Group #Header {
      Anchor: (Height: 60, Bottom: 20);
      LayoutMode: Left;

      Label {
        Text: "QUEST BOARD";
        FlexWeight: 1;
        Style: (FontSize: 34, TextColor: #d4af37, RenderBold: true, VerticalAlignment: Center);
      }

      Label #QuestLogStatus {
        Text: "Active quests: 0";
        Anchor: (Width: 200, Height: 60);
        Style: (FontSize: 16, TextColor: #e8e0d5, HorizontalAlignment: End, VerticalAlignment: Center);
      }
    }

    Group #QuestRows {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 12);

      Group #QuestLogEmptyState {
        Anchor: (Height: 100, Bottom: 16);
        LayoutMode: Middle;
        Background: #e8e0d5(0.1);

        Label {
          Text: "The board is empty. Check back later for new tasks.";
          Anchor: (Height: 30);
          Style: (FontSize: 20, TextColor: #bcaaa4, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }

      // Reusable Note Template Pattern (x5)
      
      Group #QuestRow1 {
        Anchor: (Height: 130, Bottom: 16);
        LayoutMode: Left;
        Background: #e8e0d5;
        OutlineColor: #7a3d27;
        OutlineSize: 1;
        Padding: (Full: 14);

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #QuestRow1Title {
            Text: "Quest Title";
            Anchor: (Height: 30, Bottom: 4);
            Style: (FontSize: 22, TextColor: #3e2723, RenderBold: true, VerticalAlignment: Center);
          }

          Label #QuestRow1Summary {
            Text: "Description";
            FlexWeight: 1;
            Style: (FontSize: 15, TextColor: #5d4037, Wrap: true, VerticalAlignment: Start);
          }
        }

        Group {
          Anchor: (Width: 320, Left: 16);
          LayoutMode: Top;
          
          Label {
              Text: "REQUIREMENTS:";
              Anchor: (Height: 22, Bottom: 4);
              Style: (FontSize: 13, TextColor: #7a3d27, RenderBold: true);
          }

          Label #QuestRow1Progress {
            Text: "Lines";
            FlexWeight: 1;
            Style: (FontSize: 14, TextColor: #3e2723, Wrap: true, VerticalAlignment: Start);
          }
        }
      }

      Group #QuestRow2 {
        Anchor: (Height: 130, Bottom: 16);
        LayoutMode: Left;
        Background: #e8e0d5;
        OutlineColor: #7a3d27;
        OutlineSize: 1;
        Padding: (Full: 14);

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Label #QuestRow2Title { Text: ""; Anchor: (Height: 30, Bottom: 4); Style: (FontSize: 22, TextColor: #3e2723, RenderBold: true, VerticalAlignment: Center); }
          Label #QuestRow2Summary { Text: ""; FlexWeight: 1; Style: (FontSize: 15, TextColor: #5d4037, Wrap: true, VerticalAlignment: Start); }
        }

        Group {
          Anchor: (Width: 320, Left: 16);
          LayoutMode: Top;
          Label { Text: "REQUIREMENTS:"; Anchor: (Height: 22, Bottom: 4); Style: (FontSize: 13, TextColor: #7a3d27, RenderBold: true); }
          Label #QuestRow2Progress { Text: ""; FlexWeight: 1; Style: (FontSize: 14, TextColor: #3e2723, Wrap: true, VerticalAlignment: Start); }
        }
      }

      Group #QuestRow3 {
        Anchor: (Height: 130, Bottom: 16);
        LayoutMode: Left;
        Background: #e8e0d5;
        OutlineColor: #7a3d27;
        OutlineSize: 1;
        Padding: (Full: 14);

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Label #QuestRow3Title { Text: ""; Anchor: (Height: 30, Bottom: 4); Style: (FontSize: 22, TextColor: #3e2723, RenderBold: true, VerticalAlignment: Center); }
          Label #QuestRow3Summary { Text: ""; FlexWeight: 1; Style: (FontSize: 15, TextColor: #5d4037, Wrap: true, VerticalAlignment: Start); }
        }

        Group {
          Anchor: (Width: 320, Left: 16);
          LayoutMode: Top;
          Label { Text: "REQUIREMENTS:"; Anchor: (Height: 22, Bottom: 4); Style: (FontSize: 13, TextColor: #7a3d27, RenderBold: true); }
          Label #QuestRow3Progress { Text: ""; FlexWeight: 1; Style: (FontSize: 14, TextColor: #3e2723, Wrap: true, VerticalAlignment: Start); }
        }
      }

      Group #QuestRow4 {
        Anchor: (Height: 130, Bottom: 16);
        LayoutMode: Left;
        Background: #e8e0d5;
        OutlineColor: #7a3d27;
        OutlineSize: 1;
        Padding: (Full: 14);

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Label #QuestRow4Title { Text: ""; Anchor: (Height: 30, Bottom: 4); Style: (FontSize: 22, TextColor: #3e2723, RenderBold: true, VerticalAlignment: Center); }
          Label #QuestRow4Summary { Text: ""; FlexWeight: 1; Style: (FontSize: 15, TextColor: #5d4037, Wrap: true, VerticalAlignment: Start); }
        }

        Group {
          Anchor: (Width: 320, Left: 16);
          LayoutMode: Top;
          Label { Text: "REQUIREMENTS:"; Anchor: (Height: 22, Bottom: 4); Style: (FontSize: 13, TextColor: #7a3d27, RenderBold: true); }
          Label #QuestRow4Progress { Text: ""; FlexWeight: 1; Style: (FontSize: 14, TextColor: #3e2723, Wrap: true, VerticalAlignment: Start); }
        }
      }

      Group #QuestRow5 {
        Anchor: (Height: 130);
        LayoutMode: Left;
        Background: #e8e0d5;
        OutlineColor: #7a3d27;
        OutlineSize: 1;
        Padding: (Full: 14);

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Label #QuestRow5Title { Text: ""; Anchor: (Height: 30, Bottom: 4); Style: (FontSize: 22, TextColor: #3e2723, RenderBold: true, VerticalAlignment: Center); }
          Label #QuestRow5Summary { Text: ""; FlexWeight: 1; Style: (FontSize: 15, TextColor: #5d4037, Wrap: true, VerticalAlignment: Start); }
        }

        Group {
          Anchor: (Width: 320, Left: 16);
          LayoutMode: Top;
          Label { Text: "REQUIREMENTS:"; Anchor: (Height: 22, Bottom: 4); Style: (FontSize: 13, TextColor: #7a3d27, RenderBold: true); }
          Label #QuestRow5Progress { Text: ""; FlexWeight: 1; Style: (FontSize: 14, TextColor: #3e2723, Wrap: true, VerticalAlignment: Start); }
        }
      }
    }

    Group {
      Anchor: (Height: 60, Top: 10);
      LayoutMode: Left;
      Group { FlexWeight: 1; }
      Button #CloseBtn {
        Anchor: (Width: 140, Height: 44);
        Style: (
            Default: (Background: #4a3626),
            Hovered: (Background: #6d4c41),
            Pressed: (Background: #2c241e)
        );
        Label { Text: "LEAVE BOARD"; Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }
  }
}
