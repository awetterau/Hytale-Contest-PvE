Group #BasePlotAssignRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Middle;

  Group #Panel {
    Anchor: (Width: 740, Height: 360);
    Background: (Color: #0b1220(0.94));
    OutlineColor: #637892;
    OutlineSize: 1;
    Padding: (Full: 18);
    LayoutMode: Top;

    Label #PlotTitle {
      Text: "Plot";
      Anchor: (Height: 36, Bottom: 12);
      Style: (
        FontSize: 24,
        TextColor: #f2f7ff,
        RenderBold: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Label #StatusText {
      Text: "Status";
      Anchor: (Height: 70, Bottom: 14);
      Style: (
        FontSize: 18,
        TextColor: #d7e4f7,
        Wrap: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Start
      );
    }

    Group #NpcList {
      LayoutMode: Top;
      Anchor: (Height: 120, Bottom: 14);

      Button #BlacksmithBtn {
        Anchor: (Width: 260, Height: 40);
        Style: (
          Default: (Background: (Color: #33465f)),
          Hovered: (Background: (Color: #3f5775)),
          Pressed: (Background: (Color: #2a3c53))
        );
        Label {
          Text: "Blacksmith";
          Style: (
            FontSize: 16,
            TextColor: #f2f6ff,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }
    }

    Group {
      LayoutMode: Right;
      Anchor: (Height: 42);

      Button #PurchaseBtn {
        Anchor: (Width: 160, Height: 40, Right: 8);
        Visible: false;
        Style: (
          Default: (Background: (Color: #2f6b3a)),
          Hovered: (Background: (Color: #398447)),
          Pressed: (Background: (Color: #275730))
        );
        Label #PurchaseBtnText {
          Text: "Purchase Plot";
          Style: (
            FontSize: 15,
            TextColor: #eaffee,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }

      Button #AssignBtn {
        Anchor: (Width: 160, Height: 40, Right: 8);
        Visible: false;
        Style: (
          Default: (Background: (Color: #72501f)),
          Hovered: (Background: (Color: #8a6326)),
          Pressed: (Background: (Color: #5f431a))
        );
        Label #AssignBtnText {
          Text: "Assign NPC";
          Style: (
            FontSize: 15,
            TextColor: #eaffee,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }

      Button #CloseBtn {
        Anchor: (Width: 120, Height: 40);
        Style: (
          Default: (Background: (Color: #2f3f54)),
          Hovered: (Background: (Color: #3e536d)),
          Pressed: (Background: (Color: #263448))
        );
        Label {
          Text: "Close";
          Style: (
            FontSize: 16,
            TextColor: #f0f4ff,
            RenderBold: true,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
        }
      }
    }
  }
}
