Group #TalkRoot {
  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
  LayoutMode: Bottom;
  Padding: (Bottom: 30);

  Group #TalkPanel {
    Anchor: (Width: 980, Height: 230);
    Background: (Color: #0b0f16(0.94));
    OutlineColor: #60738f;
    OutlineSize: 1;
    Padding: (Left: 22, Right: 22, Top: 18, Bottom: 16);
    LayoutMode: Top;

    Label #NpcName {
      Text: "Blacksmith";
      Anchor: (Height: 30, Bottom: 8);
      Style: (
        FontSize: 22,
        TextColor: #f0c57b,
        RenderBold: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Label #DialogueText {
      Text: "";
      Anchor: (Bottom: 10);
      Style: (
        FontSize: 20,
        TextColor: #e6edf8,
        Wrap: true,
        HorizontalAlignment: Start,
        VerticalAlignment: Start
      );
      FlexWeight: 1;
    }

    Label #PromptText {
      Text: "";
      Anchor: (Height: 26, Bottom: 10);
      Style: (
        FontSize: 14,
        TextColor: #a9bfd9,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Button #NextBtn {
      Anchor: (Width: 170, Height: 38, Bottom: 4);
      Style: (
        Default: (Background: (Color: #425d7c)),
        Hovered: (Background: (Color: #4f7196)),
        Pressed: (Background: (Color: #364d68))
      );
      Label {
        Text: "Continue";
        Style: (
          FontSize: 16,
          TextColor: #f0f4ff,
          RenderBold: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }
    }

    Button #ReturnBtn {
      Anchor: (Width: 170, Height: 38, Bottom: 4);
      Visible: false;
      Style: (
        Default: (Background: (Color: #2f3f54)),
        Hovered: (Background: (Color: #3e536d)),
        Pressed: (Background: (Color: #263448))
      );
      Label {
        Text: "Return";
        Style: (
          FontSize: 16,
          TextColor: #f0f4ff,
          RenderBold: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }
    }
  }
}
