$C = "../Common.ui";

@SlotSize = 60;
@SlotGap = 4;

Group #Root {
  Anchor: (Full: 0);
  LayoutMode: Middle;
  Background: #000000(0.8);

  Group #Panel {
    Anchor: (Width: 1000, Height: 850);
    Background: #1a1512;
    OutlineColor: #4a3626;
    OutlineSize: 2;
    Padding: (Full: 20);
    LayoutMode: Top;

    Group #Header {
      Anchor: (Height: 56, Bottom: 16);
      LayoutMode: Left;
      Padding: (Full: 4);

      Label {
        Text: "STASH";
        FlexWeight: 1;
        Style: (FontSize: 32, TextColor: #d4af37, RenderBold: true, VerticalAlignment: Center);
      }

      Group #HeaderControls {
        LayoutMode: Left;
        Anchor: (Width: 400, Height: 44);

        Label #AmountLabel {
            Text: "Amount:";
            Anchor: (Width: 80, Height: 44);
            Style: (FontSize: 16, TextColor: #d4af37, VerticalAlignment: Center);
        }

        TextField #AmountInput {
          Anchor: (Width: 100, Height: 38);
          Background: #0a0807;
          Style: (FontSize: 16, TextColor: #d4af37);
        }
      }

      Button #FullStackButton {
        Anchor: (Width: 160, Height: 42);
        Style: (
          Default: (Background: #2c241e),
          Hovered: (Background: #4a3626),
          Pressed: (Background: #1a1512)
        );
        Label #FullStackLabel { Text: "FULL STACK: ON"; Style: (FontSize: 14, TextColor: #e8e0d5, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }

      Button #CloseButton {
        Anchor: (Width: 110, Height: 42);
        Style: (
            Default: (Background: #4a3626),
            Hovered: (Background: #6d4c41),
            Pressed: (Background: #2c241e)
        );
        Label { Text: "CLOSE"; Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }

    Group #Content {
      FlexWeight: 1;
      LayoutMode: Top;

      Group #StashSection {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Bottom: 16);

        Group #StashSubHeader {
          Anchor: (Height: 40, Bottom: 8);
          LayoutMode: Left;
          Label {
            Text: "Stash Contents";
            FlexWeight: 1;
            Style: (FontSize: 22, TextColor: #e8e0d5, RenderBold: true, VerticalAlignment: Center);
          }
          
          Group #SearchGroup {
            Anchor: (Width: 320, Height: 32);
            LayoutMode: Left;
            
            Label {
                Text: "Search:";
                Anchor: (Width: 60, Height: 32);
                Style: (FontSize: 14, TextColor: #d4af37, VerticalAlignment: Center);
            }

            TextField #StashSearch {
                FlexWeight: 1;
                Background: #0a0807(0.5);
                Style: (FontSize: 14, TextColor: #f0f0f0);
            }
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Background: #0a0807(0.85);
          OutlineColor: #4a3626;
          OutlineSize: 1;
          ScrollbarStyle: ScrollbarStyle(Spacing: 4, Size: 6, Background: #212121, Handle: #8d6e63, HoveredHandle: #a1887f, DraggedHandle: #bcaaa4);
          Padding: (Full: 12);

          Group #StashGrid {
            Anchor: (Left: 0, Right: 0);
            LayoutMode: LeftCenterWrap;
          }
        }

        Label #StashCountLabel {
          Anchor: (Height: 20, Top: 6);
          Text: "";
          Style: (FontSize: 14, TextColor: #d4af37);
        }
      }

      Group #InventorySection {
        Anchor: (Height: 280);
        LayoutMode: Top;

        Label {
          Anchor: (Height: 32, Bottom: 8);
          Text: "Inventory";
          Style: (FontSize: 22, TextColor: #e8e0d5, RenderBold: true);
        }

        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Background: #0a0807(0.85);
          OutlineColor: #4a3626;
          OutlineSize: 1;
          ScrollbarStyle: ScrollbarStyle(Spacing: 4, Size: 6, Background: #212121, Handle: #8d6e63, HoveredHandle: #a1887f, DraggedHandle: #bcaaa4);
          Padding: (Full: 12);

          Group #InventoryGrid {
            Anchor: (Left: 0, Right: 0);
            LayoutMode: LeftCenterWrap;
          }
        }

        Label #InventoryCountLabel {
          Anchor: (Height: 20, Top: 6);
          Text: "";
          Style: (FontSize: 14, TextColor: #d4af37);
        }
      }
    }

    Label #StatusLabel {
      Anchor: (Height: 24, Top: 8);
      Text: "";
      Style: (FontSize: 12, TextColor: #a1887f, HorizontalAlignment: Center, VerticalAlignment: Center);
    }
  }
}
