    Label #TradeLabel {
      Text: "Trade Editor";
      Anchor: (Height: 22, Bottom: 6);
      Style: (FontSize: 17, TextColor: #eef5ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
