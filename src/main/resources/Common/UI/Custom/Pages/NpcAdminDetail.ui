    Label #TradeNote {
      Text: "Trade note";
      Anchor: (Height: 20, Bottom: 10);
      Style: (FontSize: 14, TextColor: #b9cbe0, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Group #TradeNavigation {
      Anchor: (Height: 44, Bottom: 14);
      LayoutMode: Right;
      Button #TradePrevBtn { Anchor: (Width: 120, Height: 40, Right: 8); Style: (Default: (Background: (Color: #384353)), Hovered: (Background: (Color: #455264)), Pressed: (Background: (Color: #2c3542))); Label { Text: "Previous"; Style: (FontSize: 15, TextColor: #eef4fb, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeNextBtn { Anchor: (Width: 120, Height: 40, Right: 8); Style: (Default: (Background: (Color: #384353)), Hovered: (Background: (Color: #455264)), Pressed: (Background: (Color: #2c3542))); Label { Text: "Next"; Style: (FontSize: 15, TextColor: #eef4fb, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeAddBtn { Anchor: (Width: 130, Height: 40, Right: 8); Style: (Default: (Background: (Color: #2f6f4f)), Hovered: (Background: (Color: #398760)), Pressed: (Background: (Color: #275c41))); Label { Text: "Add Trade"; Style: (FontSize: 15, TextColor: #f1fff8, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeDuplicateBtn { Anchor: (Width: 150, Height: 40, Right: 8); Style: (Default: (Background: (Color: #2f5c71)), Hovered: (Background: (Color: #396f88)), Pressed: (Background: (Color: #264a5b))); Label { Text: "Duplicate Trade"; Style: (FontSize: 15, TextColor: #eef7ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeRemoveBtn { Anchor: (Width: 140, Height: 40); Style: (Default: (Background: (Color: #7a3f3f)), Hovered: (Background: (Color: #915050)), Pressed: (Background: (Color: #653333))); Label { Text: "Remove Trade"; Style: (FontSize: 15, TextColor: #fff2f2, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }

    Group #TradeActionsPrimary {
      Anchor: (Height: 44, Bottom: 14);
      LayoutMode: Right;
      Button #TradeCostItemPrevBtn { Anchor: (Width: 160, Height: 40, Right: 8); Style: (Default: (Background: (Color: #3d556b)), Hovered: (Background: (Color: #4c6982)), Pressed: (Background: (Color: #314555))); Label { Text: "Prev Cost Item"; Style: (FontSize: 15, TextColor: #eef6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeCostItemNextBtn { Anchor: (Width: 160, Height: 40, Right: 8); Style: (Default: (Background: (Color: #3d556b)), Hovered: (Background: (Color: #4c6982)), Pressed: (Background: (Color: #314555))); Label { Text: "Next Cost Item"; Style: (FontSize: 15, TextColor: #eef6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeRewardItemPrevBtn { Anchor: (Width: 170, Height: 40, Right: 8); Style: (Default: (Background: (Color: #6a5233)), Hovered: (Background: (Color: #7f633e)), Pressed: (Background: (Color: #584429))); Label { Text: "Prev Sold Item"; Style: (FontSize: 15, TextColor: #fff7ed, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeRewardItemNextBtn { Anchor: (Width: 170, Height: 40); Style: (Default: (Background: (Color: #6a5233)), Hovered: (Background: (Color: #7f633e)), Pressed: (Background: (Color: #584429))); Label { Text: "Next Sold Item"; Style: (FontSize: 15, TextColor: #fff7ed, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }

    Group #TradeActionsItem {
      Anchor: (Height: 44, Bottom: 14);
      LayoutMode: Right;
      Button #TradeCostAmountDownBtn { Anchor: (Width: 150, Height: 40, Right: 8); Style: (Default: (Background: (Color: #4f4358)), Hovered: (Background: (Color: #63536c)), Pressed: (Background: (Color: #413748))); Label { Text: "Cost Amount -1"; Style: (FontSize: 15, TextColor: #f7f1ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeCostAmountUpBtn { Anchor: (Width: 150, Height: 40, Right: 8); Style: (Default: (Background: (Color: #4f4358)), Hovered: (Background: (Color: #63536c)), Pressed: (Background: (Color: #413748))); Label { Text: "Cost Amount +1"; Style: (FontSize: 15, TextColor: #f7f1ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeRewardAmountDownBtn { Anchor: (Width: 160, Height: 40, Right: 8); Style: (Default: (Background: (Color: #42575b)), Hovered: (Background: (Color: #506c71)), Pressed: (Background: (Color: #364649))); Label { Text: "Sold Amount -1"; Style: (FontSize: 15, TextColor: #effffd, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #TradeRewardAmountUpBtn { Anchor: (Width: 160, Height: 40); Style: (Default: (Background: (Color: #42575b)), Hovered: (Background: (Color: #506c71)), Pressed: (Background: (Color: #364649))); Label { Text: "Sold Amount +1"; Style: (FontSize: 15, TextColor: #effffd, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }

    Group #TradeActionsAmount { Anchor: (Height: 0); }

    Group #ValidationCard {
      Anchor: (Height: 110, Bottom: 14);
      Background: (Color: #141d28(0.92));
      OutlineColor: #4e6077;
      OutlineSize: 1;
      Padding: (Full: 12);
      LayoutMode: Top;

      Label {
        Text: "Validation";
        Anchor: (Height: 22, Bottom: 6);
        Style: (FontSize: 18, TextColor: #eef5ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #ValidationText {
        Text: "Validation";
        Anchor: (Height: 60);
        Style: (FontSize: 15, TextColor: #dbe8f8, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
      }
    }

    Group #Buttons {
      LayoutMode: Right;
      Anchor: (Height: 44, Bottom: 10);
      Button #ResetBtn { Anchor: (Width: 190, Height: 40, Right: 8); Style: (Default: (Background: (Color: #7b3434)), Hovered: (Background: (Color: #944040)), Pressed: (Background: (Color: #652b2b))); Label { Text: "Reset NPC State"; Style: (FontSize: 15, TextColor: #fff2f2, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #ValidateBtn { Anchor: (Width: 130, Height: 40, Right: 8); Style: (Default: (Background: (Color: #2f5c71)), Hovered: (Background: (Color: #396f88)), Pressed: (Background: (Color: #264a5b))); Label { Text: "Validate"; Style: (FontSize: 15, TextColor: #eef7ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #RefreshBtn { Anchor: (Width: 120, Height: 40, Right: 8); Style: (Default: (Background: (Color: #1f5f58)), Hovered: (Background: (Color: #26736b)), Pressed: (Background: (Color: #194a45))); Label { Text: "Refresh"; Style: (FontSize: 15, TextColor: #edfffd, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #BackBtn { Anchor: (Width: 120, Height: 40, Right: 8); Style: (Default: (Background: (Color: #2e3e53)), Hovered: (Background: (Color: #394d67)), Pressed: (Background: (Color: #253345))); Label { Text: "Back"; Style: (FontSize: 15, TextColor: #eef5ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #CloseBtn { Anchor: (Width: 120, Height: 40); Style: (Default: (Background: (Color: #3a2f45)), Hovered: (Background: (Color: #4a3b58)), Pressed: (Background: (Color: #2d2435))); Label { Text: "Close"; Style: (FontSize: 15, TextColor: #f6efff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
    }
  }
}
