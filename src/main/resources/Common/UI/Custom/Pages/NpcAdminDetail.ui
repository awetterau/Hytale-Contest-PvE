      Anchor: (Height: 20, Bottom: 10);
      Style: (FontSize: 14, TextColor: #b9cbe0, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Group #QuestActions {
      Anchor: (Height: 44, Bottom: 14);
      LayoutMode: Right;
      Button #QuestResetBtn { Anchor: (Width: 160, Height: 40, Right: 8); Style: (Default: (Background: (Color: #7a3f3f)), Hovered: (Background: (Color: #915050)), Pressed: (Background: (Color: #653333))); Label { Text: "Reset Quest State"; Style: (FontSize: 15, TextColor: #fff2f2, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #QuestClearAcceptedBtn { Anchor: (Width: 170, Height: 40, Right: 8); Style: (Default: (Background: (Color: #3e566f)), Hovered: (Background: (Color: #4b6888)), Pressed: (Background: (Color: #334559))); Label { Text: "Clear Accepted"; Style: (FontSize: 15, TextColor: #eef6ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #QuestClearCompletedBtn { Anchor: (Width: 175, Height: 40, Right: 8); Style: (Default: (Background: (Color: #40586a)), Hovered: (Background: (Color: #4d6b80)), Pressed: (Background: (Color: #344754))); Label { Text: "Clear Completed"; Style: (FontSize: 15, TextColor: #eef8ff, HorizontalAlignment: Center, VerticalAlignment: Center); } }
      Button #QuestCompleteLinkedBtn { Anchor: (Width: 190, Height: 40); Style: (Default: (Background: (Color: #2f6f4f)), Hovered: (Background: (Color: #398760)), Pressed: (Background: (Color: #275c41))); Label { Text: "Complete Linked Quests"; Style: (FontSize: 15, TextColor: #f1fff8, HorizontalAlignment: Center, VerticalAlignment: Center); } }
