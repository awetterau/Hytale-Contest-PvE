Group {
  Anchor: (Left: 56, Top: 66, Width: 720, Height: 660);

  Button #PrevCoreButton {
    Anchor: (Left: 0, Top: 236, Width: 96, Height: 48);
    Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button.png"));
    Label #PrevCoreButtonLabel {
      Text: "No cores";
      Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
    }
  }

  Button #NextCoreButton {
    Anchor: (Right: 0, Top: 236, Width: 96, Height: 48);
    Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button.png"));
    Label #NextCoreButtonLabel {
      Text: "No cores";
      Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
    }
  }

  Group {
    Background: (PatchStyle(TexturePath: "../Textures/UI_D97_BackGround.png"));
    Anchor: (Left: 108, Top: 18, Right: 108, Bottom: 0);

    Label {
      Anchor: (Left: 20, Top: 16, Right: 20, Height: 24);
      Text: "Crimson Control";
      Style: (HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
    }

    Label #ActiveCoreLabel {
      Anchor: (Left: 20, Top: 54, Right: 20, Height: 28);
      Text: "Selected Candidate: Not set";
      Style: (HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, FontSize: 23);
    }

    Label #CandidateSummaryLabel {
      Anchor: (Left: 20, Top: 88, Right: 20, Height: 18);
      Text: "Saved candidates: 0 | Starts per run: 0";
      Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    Button #SetCoreButton {
      Anchor: (Left: 22, Top: 122, Right: 22, Height: 34);
      Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button_Light.png"));
      Label {
        Text: "Add Candidate From Current Position";
        Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Button #RemoveCoreButton {
      Anchor: (Left: 22, Top: 162, Right: 22, Height: 34);
      Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button_Light.png"));
      Label {
        Text: "Remove Selected Candidate";
        Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Group {
      Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button.png"));
      Anchor: (Left: 22, Top: 214, Right: 22, Height: 216);

      Label {
        Anchor: (Left: 16, Top: 12, Right: 16, Height: 22);
        Text: "Global Run Settings";
        Style: (HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
      }

      Label #RadiusRowLabel {
        Anchor: (Left: 20, Top: 50, Width: 180, Height: 18);
        Text: "Radius";
        Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
      }

      Label #RadiusValueLabel {
        Anchor: (Left: 20, Top: 70, Width: 250, Height: 18);
        Text: "Global Radius: 6";
        Style: (HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      NumberField #RadiusInput {
        Anchor: (Right: 20, Top: 58, Width: 164, Height: 30);
        Value: 6;
      }

      Label #StartRowLabel {
        Anchor: (Left: 20, Top: 104, Width: 180, Height: 18);
        Text: "Spread Seconds";
        Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
      }

      Label #StartValueLabel {
        Anchor: (Left: 20, Top: 124, Width: 250, Height: 18);
        Text: "Global Spread Seconds: 9";
        Style: (HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      NumberField #StartInput {
        Anchor: (Right: 20, Top: 112, Width: 164, Height: 30);
        Value: 9;
      }

      Label #ChooseRowLabel {
        Anchor: (Left: 20, Top: 158, Width: 230, Height: 18);
        Text: "Active Core Count Per Run";
        Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
      }

      Label #ChooseCountValueLabel {
        Anchor: (Left: 20, Top: 178, Width: 270, Height: 18);
        Text: "Global Active Core Count: 1";
        Style: (HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      NumberField #ChooseCountInput {
        Anchor: (Right: 20, Top: 166, Width: 164, Height: 30);
        Value: 1;
      }
    }

    Label {
      Anchor: (Left: 24, Top: 438, Right: 24, Height: 30);
      Text: "Global settings apply to every saved candidate in this world.";
      Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    Button #StartWaveButton {
      Anchor: (Left: 22, Top: 478, Right: 22, Height: 34);
      Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button_Light.png"));
      Label {
        Text: "Start Selected Candidate Now";
        Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Button #UndoButton {
      Anchor: (Left: 22, Top: 518, Right: 22, Height: 34);
      Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button_Light.png"));
      Label {
        Text: "Undo Selected Candidate";
        Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Button #GlobalUndoButton {
      Anchor: (Left: 22, Top: 558, Right: 22, Height: 34);
      Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button_Light.png"));
      Label {
        Text: "Global Undo";
        Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Button #CloseButton {
      Anchor: (Left: 22, Top: 598, Right: 22, Height: 34);
      Background: (PatchStyle(TexturePath: "../Textures/UI_D97_Button_Light.png"));
      Label {
        Text: "Close";
        Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }
  }
}
