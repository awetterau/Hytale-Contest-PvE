      TextButton #ChunkSetPinnedButton { Anchor: (Left: 8, Top: 32, Width: 145, Height: 28); Text: "Set PIN"; Background: (Color: #441010(0.92)); }
      TextButton #ChunkSetMarkerButton { Anchor: (Left: 160, Top: 32, Width: 145, Height: 28); Text: "Set MARKER"; Background: (Color: #441010(0.92)); }
      TextButton #ChunkSetClearButton { Anchor: (Left: 312, Top: 32, Width: 145, Height: 28); Text: "Deselect"; Background: (Color: #441010(0.92)); }

      Label {
