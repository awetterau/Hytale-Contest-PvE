      Label #ChunkBrushRangeValue { Anchor: (Left: 164, Top: 70, Width: 40, Height: 24); Text: "0"; Style: (HorizontalAlignment: Center, VerticalAlignment: Center); }
      TextButton #ChunkBrushRangeUpButton { Anchor: (Left: 208, Top: 70, Width: 28, Height: 24); Text: "+"; Background: (Color: #441010(0.92)); }
      Label #ChunkBrushSizeLabel { Anchor: (Left: 244, Top: 72, Width: 180, Height: 20); Text: "Brush: 1x1"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      TextButton #ChunkReloadFileButton { Anchor: (Left: 312, Top: 98, Width: 145, Height: 28); Text: "Reload file"; Background: (Color: #441010(0.92)); Visible: false; }
      Label { Anchor: (Left: 8, Top: 106, Right: 8, Height: 24); Text: "Range max: 5 (0 = current chunk only)"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
    }

