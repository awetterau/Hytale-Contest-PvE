Group {
  Anchor: (Left: 36, Top: 36, Right: 36, Bottom: 36);

  Group {
    Anchor: (Left: 0, Top: 0, Width: 230, Bottom: 0);
    Background: (Color: #7a2020(0.40));

    Label {
      Anchor: (Left: 10, Top: 10, Right: 10, Height: 24);
      Text: "BLIGHTFALL";
      Style: (HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true, FontSize: 20);
    }

    Label #WorldLabel {
      Anchor: (Left: 10, Top: 36, Right: 10, Height: 18);
      Text: "World:";
      Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    TextButton #NavRunButton {
      Anchor: (Left: 10, Top: 72, Right: 10, Height: 36);
      Text: "Run Control";
      Background: (Color: #441010(0.92));
    }

    TextButton #NavRedButton {
      Anchor: (Left: 10, Top: 114, Right: 10, Height: 36);
      Text: "Infection manager";
      Background: (Color: #441010(0.92));
    }

    TextButton #NavExtractionButton {
      Anchor: (Left: 10, Top: 156, Right: 10, Height: 36);
      Text: "Extractions";
      Background: (Color: #441010(0.92));
    }

    TextButton #NavChunksButton {
      Anchor: (Left: 10, Top: 198, Right: 10, Height: 36);
      Text: "Chunk Tools";
      Background: (Color: #441010(0.92));
    }
  }

  Group {
    Anchor: (Left: 246, Top: 0, Right: 396, Bottom: 0);
    Background: (Color: #7a2020(0.30));

    Label #SectionLabel {
      Anchor: (Left: 8, Top: 10, Right: 8, Height: 24);
      Text: "Section:";
      Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
    }

    Label #TemplateWorldLabel {
      Anchor: (Left: 8, Top: 44, Width: 120, Height: 18);
      Text: "Template world:";
      Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
    }

    TextField #TemplateInput {
      Anchor: (Left: 126, Top: 40, Width: 180, Height: 26);
      Value: "game";
      Background: (Color: #6a2b8e(0.35));
    }

    Label #RunDurationLabel {
      Anchor: (Left: 314, Top: 44, Width: 92, Height: 18);
      Text: "Duration(s):";
      Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
    }

    NumberField #RunDurationInput {
      Anchor: (Left: 404, Top: 40, Width: 120, Height: 26);
      Value: 1200;
      Background: (Color: #6a2b8e(0.35));
    }

    Label #RunSeedLabel {
      Anchor: (Left: 532, Top: 44, Width: 38, Height: 18);
      Text: "Seed:";
      Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
    }

    TextField #RunSeedInput {
      Anchor: (Left: 572, Top: 40, Width: 86, Height: 26);
      Value: "";
      Background: (Color: #6a2b8e(0.35));
    }

    Label #RunTimeHourLabel {
      Anchor: (Left: 662, Top: 74, Width: 42, Height: 18);
      Text: "Time:";
      Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
    }

    NumberField #RunTimeHourMinInput {
      Anchor: (Left: 706, Top: 70, Width: 34, Height: 26);
      Value: 8;
      Background: (Color: #6a2b8e(0.35));
    }

    NumberField #RunTimeHourMaxInput {
      Anchor: (Left: 744, Top: 70, Width: 34, Height: 26);
      Value: 8;
      Background: (Color: #6a2b8e(0.35));
    }

    TextButton #ApplyGameControlButton {
      Anchor: (Right: 16, Top: 40, Width: 126, Height: 26);
      Text: "Apply";
      Background: (Color: #441010(0.92));
    }

    Label #CenterContent {
      Anchor: (Left: 8, Top: 74, Right: 8, Height: 94);
      Text: "";
      Style: (HorizontalAlignment: Start, VerticalAlignment: Start);
    }

    Group #ExtractionConfigSection {
      Anchor: (Left: 8, Top: 176, Right: 8, Height: 418);
      Background: (Color: #2f0b0b(0.72));
      Visible: false;

      Label {
        Anchor: (Left: 8, Top: 8, Width: 220, Height: 18);
        Text: "Extraction config";
        Style: (HorizontalAlignment: Start, VerticalAlignment: Center, RenderBold: true);
      }

      Label { Anchor: (Left: 8, Top: 36, Width: 200, Height: 18); Text: "Run enable from second"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionRunFromInput { Anchor: (Left: 210, Top: 32, Right: 8, Height: 24); Value: 0; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 66, Width: 200, Height: 18); Text: "Run disable after second"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionRunUntilInput { Anchor: (Left: 210, Top: 62, Right: 8, Height: 24); Value: 1200; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 96, Width: 200, Height: 18); Text: "Extraction wait (seconds)"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionWaitInput { Anchor: (Left: 210, Top: 92, Right: 8, Height: 24); Value: 20; Background: (Color: #6a2b8e(0.35)); }
      Label { Anchor: (Left: 8, Top: 126, Width: 200, Height: 18); Text: "Extraction window (seconds)"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionWindowInput { Anchor: (Left: 210, Top: 122, Right: 8, Height: 24); Value: 1; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 156, Width: 200, Height: 18); Text: "Enemy waves enabled"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      TextField #ExtractionEnemyWavesInput { Anchor: (Left: 210, Top: 152, Right: 8, Height: 24); Value: "true"; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 186, Width: 200, Height: 18); Text: "Enemies per wave"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionEnemyMobsPerWaveInput { Anchor: (Left: 210, Top: 182, Right: 8, Height: 24); Value: 2; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 216, Width: 200, Height: 18); Text: "Core max health"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionCoreMaxHealthInput { Anchor: (Left: 210, Top: 212, Right: 8, Height: 24); Value: 300; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 246, Width: 200, Height: 18); Text: "Extraction radius blocks"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionRadiusInput { Anchor: (Left: 210, Top: 242, Right: 8, Height: 24); Value: 6; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 276, Width: 110, Height: 18); Text: "Extract min H"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionMinHeightInput { Anchor: (Left: 122, Top: 272, Width: 120, Height: 24); Value: -1; Background: (Color: #6a2b8e(0.35)); }
      Label { Anchor: (Left: 248, Top: 276, Width: 84, Height: 18); Text: "Extract max H"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionMaxHeightInput { Anchor: (Left: 334, Top: 272, Right: 8, Height: 24); Value: 3; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 306, Width: 180, Height: 18); Text: "Enemy spawn min/max R"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionEnemySpawnMinRadiusInput { Anchor: (Left: 190, Top: 302, Width: 90, Height: 24); Value: 7; Background: (Color: #6a2b8e(0.35)); }
      NumberField #ExtractionEnemySpawnMaxRadiusInput { Anchor: (Left: 286, Top: 302, Right: 8, Height: 24); Value: 16; Background: (Color: #6a2b8e(0.35)); }

      Label { Anchor: (Left: 8, Top: 336, Width: 180, Height: 18); Text: "Enemy spawn min/max H"; Style: (HorizontalAlignment: Start, VerticalAlignment: Center); }
      NumberField #ExtractionEnemySpawnMinHeightInput { Anchor: (Left: 190, Top: 332, Width: 90, Height: 24); Value: -8; Background: (Color: #6a2b8e(0.35)); }
      NumberField #ExtractionEnemySpawnMaxHeightInput { Anchor: (Left: 286, Top: 332, Right: 8, Height: 24); Value: 4; Background: (Color: #6a2b8e(0.35)); }

      TextButton #ExtractionApplyButton { Anchor: (Right: 8, Top: 378, Width: 140, Height: 24); Text: "Apply extraction"; Background: (Color: #441010(0.92)); }
