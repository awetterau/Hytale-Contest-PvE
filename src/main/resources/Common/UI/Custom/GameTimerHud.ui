// GameTimerHud.ui - Custom UI for displaying the game timer

Group #GameTimerHud {
  Anchor: (Top: 35, Width: 150, Height: 30);
  Padding: (Full: 8);
  LayoutMode: Middle;

  Label #TimerLabel {
    Text: "05:00";
    Style: (
      FontSize: 24,
      TextColor: #ffffff,
      HorizontalAlignment: Center,
      VerticalAlignment: Center,
      RenderBold: true
    );
  }
}
