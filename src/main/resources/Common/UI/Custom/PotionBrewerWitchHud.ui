Group #PotionBrewerWitchHud {
  Anchor: (Top: 12, Left: 12, Width: 300, Height: 194);
  Background: (Color: #120f18(0.9));
  OutlineColor: #6c5b84;
  OutlineSize: 1;
  Padding: (Full: 10);
  LayoutMode: Top;

  // Added Game Timer elements
  Group #GameTimerContainer {
    Anchor: (Height: 30, Bottom: 8);
    LayoutMode: Middle;
    
    Label #TimerLabel {
      Text: "05:00";
      Style: (
        FontSize: 24,
        TextColor: #ffffff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderBold: true
      );
    }
  }

  Label #TitleLabel {
    Text: "Potion Brewer Witch";
    Anchor: (Height: 24, Bottom: 4);
    Style: (FontSize: 16, TextColor: #f3e9ff, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
  }

  Label #StatusLabel {
    Text: "";
    Anchor: (Height: 18, Bottom: 8);
    Style: (FontSize: 12, TextColor: #cbbce3, HorizontalAlignment: Start, VerticalAlignment: Center);
  }

  Label #HealthLabel {
    Text: "";
    Anchor: (Height: 18, Bottom: 4);
    Style: (FontSize: 12, TextColor: #f0d7db, HorizontalAlignment: Start, VerticalAlignment: Center);
  }

  ProgressBar #HealthBar {
    Value: 0.0;
    Anchor: (Height: 16, Bottom: 10);
    Background: #2b1d24(0.9);
    OutlineColor: #111111;
    OutlineSize: 1;
    Bar: #b8485d(1.0);
  }

  Group #ChargeRow1 {
    LayoutMode: Left;
    Anchor: (Height: 22, Bottom: 4);
    Visible: false;

    Group #Charge1Poison {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #4f995d(1.0));
      Visible: false;
    }

    Group #Charge1Shadow {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #5e5c9e(1.0));
      Visible: false;
    }

    Group #Charge1Blood {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #9b2d38(1.0));
      Visible: false;
    }

    Group #Charge1Holy {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #d2b356(1.0));
      Visible: false;
    }

    Group #Charge1Binding {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #8c4fbc(1.0));
      Visible: false;
    }

    Group #Charge1Healing {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #59a7d8(1.0));
      Visible: false;
    }

    Label #ChargeText1 {
      Text: "";
      Style: (FontSize: 13, TextColor: #e5e0ef, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  Group #ChargeRow2 {
    LayoutMode: Left;
    Anchor: (Height: 22, Bottom: 4);
    Visible: false;

    Group #Charge2Poison {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #4f995d(1.0));
      Visible: false;
    }

    Group #Charge2Shadow {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #5e5c9e(1.0));
      Visible: false;
    }

    Group #Charge2Blood {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #9b2d38(1.0));
      Visible: false;
    }

    Group #Charge2Holy {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #d2b356(1.0));
      Visible: false;
    }

    Group #Charge2Binding {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #8c4fbc(1.0));
      Visible: false;
    }

    Group #Charge2Healing {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #59a7d8(1.0));
      Visible: false;
    }

    Label #ChargeText2 {
      Text: "";
      Style: (FontSize: 13, TextColor: #e5e0ef, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  Group #ChargeRow3 {
    LayoutMode: Left;
    Anchor: (Height: 22);
    Visible: false;

    Group #Charge3Poison {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #4f995d(1.0));
      Visible: false;
    }

    Group #Charge3Shadow {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #5e5c9e(1.0));
      Visible: false;
    }

    Group #Charge3Blood {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #9b2d38(1.0));
      Visible: false;
    }

    Group #Charge3Holy {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #d2b356(1.0));
      Visible: false;
    }

    Group #Charge3Binding {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #8c4fbc(1.0));
      Visible: false;
    }

    Group #Charge3Healing {
      Anchor: (Width: 14, Height: 14, Right: 8);
      Background: (Color: #59a7d8(1.0));
      Visible: false;
    }

    Label #ChargeText3 {
      Text: "";
      Style: (FontSize: 13, TextColor: #e5e0ef, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }
}
