Group #PotionBrewerWitchHud {
  Anchor: (Top: 34, Width: 520, Height: 64);

  Group #HeaderLayer {
    Anchor: (Top: 0, Width: 520, Height: 26);

    Label #TitleLabel {
      Text: "Crimson Witch";
      Anchor: (Top: 0, Width: 520, Height: 26);
      Style: (
        FontSize: 18,
        TextColor: #f6d6dc,
        RenderBold: true,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }

    Group #ChargeStrip {
      Anchor: (Top: 4, Left: 330, Width: 120, Height: 18);
      LayoutMode: Left;

      Group #ChargeSlot1 {
        Anchor: (Width: 18, Height: 18, Right: 8);
        Visible: false;

        Group #Charge1Poison {
          Anchor: (Full: 0);
          Background: (Color: #4f995d(1.0));
          Visible: false;
        }

        Group #Charge1Shadow {
          Anchor: (Full: 0);
          Background: (Color: #5e5c9e(1.0));
          Visible: false;
        }

        Group #Charge1Blood {
