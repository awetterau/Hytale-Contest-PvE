  ProgressBar #PhaseThreeBar {
    Value: 1.0;
    Anchor: (Top: 34, Width: 520, Height: 16);
    Background: #151021(0.45);
    OutlineColor: #0b0507;
    OutlineSize: 1;
    Bar: #3f6bc8(1.0);
  }

  ProgressBar #PhaseTwoBar {
