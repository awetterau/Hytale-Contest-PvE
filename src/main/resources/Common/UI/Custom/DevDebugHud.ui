Group #DevDebugHud {
  Anchor: (Top: 10, Left: 10, Width: 560, Height: 220);
  Background: (Color: #0a1018(0.85));
  OutlineColor: #58708f;
  OutlineSize: 1;
  Padding: (Full: 8);
  LayoutMode: Top;

