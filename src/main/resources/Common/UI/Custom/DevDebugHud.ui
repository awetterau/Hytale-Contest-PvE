  Label #Line5 { Text: ""; Anchor: (Height: 24); Style: (FontSize: 13, TextColor: #dce7f7, HorizontalAlignment: Start, VerticalAlignment: Center); }
  Label #Line6 { Text: ""; Anchor: (Height: 24); Style: (FontSize: 13, TextColor: #dce7f7, HorizontalAlignment: Start, VerticalAlignment: Center); }
  Label #Line7 { Text: ""; Anchor: (Height: 24); Style: (FontSize: 13, TextColor: #dce7f7, HorizontalAlignment: Start, VerticalAlignment: Center); }
  Label #Line8 { Text: ""; Anchor: (Height: 24); Style: (FontSize: 13, TextColor: #dce7f7, HorizontalAlignment: Start, VerticalAlignment: Center); }
